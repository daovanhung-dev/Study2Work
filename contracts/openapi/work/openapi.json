      "post": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "closeJob", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } }
