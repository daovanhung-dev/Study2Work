        { "name": "revisionId", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "publishCandidateCvRevision", "parameters": [{ "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" }, "412": { "$ref": "#/components/responses/WorkError" } } }
