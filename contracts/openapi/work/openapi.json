      "parameters": [{ "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } }],
      "post": { "tags": ["Work"], "operationId": "acceptWebhook", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } }
    }
  },
  "components": {
    "parameters": {
      "IncomingTraceId": {
        "name": "X-Trace-Id",
        "in": "header",
        "required": false,
        "description": "Caller-provided trace identifier. The API generates one when it is absent or invalid.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Stable client key for retry-safe mutations.",
        "schema": { "type": "string", "minLength": 8, "maxLength": 191 }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": false,
        "description": "Revision version used for optimistic concurrency.",
        "schema": { "type": "string" }
      }
    },
    "headers": {
      "TraceId": {
        "description": "The request trace identifier. It matches the response body's traceId.",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "WorkSuccess": {
        "description": "Successful Work response.",
        "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiSuccessEnvelope" } } }
      },
      "WorkError": {
        "description": "Safe Work error response.",
        "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } } }
      }
    },
    "schemas": {
      "ApiMeta": {
        "type": "object",
        "properties": {
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          }
        },
        "additionalProperties": true
      },
      "ApiSuccessEnvelope": {
        "type": "object",
        "required": ["success", "businessCode", "message", "data", "meta", "traceId"],
        "properties": {
          "success": {
            "const": true
          },
          "businessCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {},
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ApiErrorDetail": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "required": ["success", "businessCode", "message", "data", "meta", "traceId"],
        "properties": {
          "success": {
            "const": false
          },
          "businessCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "null"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiErrorMeta"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ApiErrorMeta": {
        "type": "object",
        "required": ["fieldErrors"],
        "properties": {
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          }
        },
        "additionalProperties": true
      },
      "RootData": {
        "type": "object",
        "required": ["service"],
        "properties": {
          "service": {
            "const": "work-api"
          }
        },
        "additionalProperties": false
      },
      "LiveHealthData": {
        "type": "object",
        "required": ["service", "environment"],
        "properties": {
          "service": {
            "const": "work-api"
          },
          "environment": {
            "type": "string",
            "enum": ["local", "test", "staging", "production"]
          }
        },
        "additionalProperties": false
      },
      "ReadyHealthData": {
        "type": "object",
        "required": ["service", "environment", "dependencies"],
        "properties": {
          "service": {
            "const": "work-api"
          },
          "environment": {
            "type": "string",
            "enum": ["local", "test", "staging", "production"]
          },
          "dependencies": {
            "type": "object",
            "required": ["database", "redis"],
            "properties": {
              "database": {
                "const": "configured"
              },
              "redis": {
                "type": "string",
                "enum": ["configured", "not_configured"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "LiveHealthEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiSuccessEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "businessCode": {
                "const": "SYSTEM_HEALTH_LIVE"
              },
              "message": {
                "const": "Work API is live."
              },
              "data": {
                "$ref": "#/components/schemas/LiveHealthData"
              }
            }
          }
        ]
      },
      "RootEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiSuccessEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "businessCode": {
                "const": "SYSTEM_ROOT_LOADED"
              },
              "message": {
                "const": "Welcome to Study2Work."
              },
              "data": {
                "$ref": "#/components/schemas/RootData"
              }
            }
          }
        ]
      },
      "ReadyHealthEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiSuccessEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "businessCode": {
                "const": "SYSTEM_HEALTH_READY"
              },
              "message": {
                "const": "Work API is ready."
              },
              "data": {
                "$ref": "#/components/schemas/ReadyHealthData"
              }
            }
          }
        ]
      },
      "ReadyUnavailableEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiErrorEnvelope"
          },
          {
            "type": "object",
            "properties": {
              "businessCode": {
                "const": "DEPENDENCY_UNAVAILABLE"
              },
              "message": {
                "const": "Work API is not ready."
              }
            }
          }
        ]
      }
    }
  }
}
