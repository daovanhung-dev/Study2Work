{
  "openapi": "3.1.0",
  "info": {
    "title": "Study2Work Work API",
    "version": "0.1.0",
    "description": "Executable contract for the independently deployed Work API. All responses use the canonical envelope and all authenticated mutations require server-side authorization; payment and storage integrations remain dependency-authoritative."
  },
  "servers": [
    {
      "url": "http://localhost:8001",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Unauthenticated process and dependency configuration checks."
    },
    {
      "name": "System",
      "description": "Unauthenticated API service metadata."
    },
    {
      "name": "Work",
      "description": "Public jobs, candidate workflows, tenant ATS, university projections, communication, interviews, billing and operations."
    }
  ],
  "paths": {
    "/api/v1": {
      "get": {
        "tags": ["System"],
        "operationId": "getWorkApiRoot",
        "summary": "Get Work API service metadata",
        "parameters": [
          {
            "$ref": "#/components/parameters/IncomingTraceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Work API service metadata.",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": ["Health"],
        "operationId": "getWorkHealthLive",
        "summary": "Check whether the Work API process is live",
        "parameters": [
          {
            "$ref": "#/components/parameters/IncomingTraceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Work API is live.",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealthEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["Health"],
        "operationId": "getWorkHealthReady",
        "summary": "Check whether the Work API is configured to serve requests",
        "parameters": [
          {
            "$ref": "#/components/parameters/IncomingTraceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Work API is ready.",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealthEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "The Work database is temporarily unavailable.",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyUnavailableEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": { "tags": ["Work"], "operationId": "listPublicJobs", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } }
    },
    "/api/v1/jobs/{slug}": {
      "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Work"], "operationId": "getPublicJob", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" }, "404": { "$ref": "#/components/responses/WorkError" } } }
    },
    "/api/v1/companies/{slug}": {
      "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "tags": ["Work"], "operationId": "getPublicCompany", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } }
    },
    "/api/v1/me": {
      "get": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "getWorkUser", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" }, "401": { "$ref": "#/components/responses/WorkError" } } }
    },
    "/api/v1/candidate/profile": {
      "get": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "getCandidateProfile", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } },
      "patch": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "updateCandidateProfile", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" }, "409": { "$ref": "#/components/responses/WorkError" } } }
    },
    "/api/v1/candidate/privacy": {
      "get": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "getCandidatePrivacy", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } },
      "patch": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "updateCandidatePrivacy", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } }
    },
    "/api/v1/candidate/cvs": {
      "get": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "listCandidateCvs", "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } },
      "post": { "tags": ["Work"], "security": [{ "BearerAuth": [] }], "operationId": "createCandidateCv", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/WorkSuccess" } } }
