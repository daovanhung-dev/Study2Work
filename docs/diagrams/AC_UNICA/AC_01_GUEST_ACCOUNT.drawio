                <mxCell id="n1" value="&lt;b&gt;Chọn “Đăng ký”&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=16;" parent="1" vertex="1">
                    <mxGeometry x="131.5" y="370" width="245" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;Nhập email, mật khẩu, họ tên&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Kiểm tra required + định dạng cơ bản trước khi gửi.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.3;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="464.5" y="496" width="275" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;POST /api/v1/auth/register&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Tạo tài khoản mới&lt;br&gt;Input: email, password, full_name | Output: user_id, status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.6;fontSize=11;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="790" y="622" width="320" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;Validate schema + chính sách mật khẩu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Sai dữ liệu → 422 Validation Error.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.3;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="812.5" y="748" width="275" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;Kiểm tra email đã tồn tại&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;SELECT user WHERE email = request.email&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
                    <mxGeometry x="1155" y="874" width="286" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;b&gt;Email đã tồn tại?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#92400E;&quot;&gt;YES → 409 Conflict; NO → tiếp tục.&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1">
                    <mxGeometry x="904" y="1000" width="92" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="err6" value="&lt;b&gt;Nhánh NO / ERROR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;YES → 409 Conflict; NO → tiếp tục.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.3;fontSize=10;align=center;verticalAlign=middle;spacing=5;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1885" y="1000" width="220" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="&lt;b&gt;Hash mật khẩu + tạo User Entity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Gán role mặc định STUDENT và trạng thái phù hợp.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.3;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="812.5" y="1126" width="275" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="&lt;b&gt;INSERT user + hồ sơ mặc định&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Transaction: user/profile.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
                    <mxGeometry x="1155" y="1252" width="286" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="&lt;b&gt;POST /api/v1/auth/verify-email/send&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Gửi mã/link xác thực nếu bật verification&lt;br&gt;Input: user_id/email | Output: queued&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.6;fontSize=11;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="790" y="1378" width="320" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="&lt;b&gt;Email Provider gửi verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#475569;&quot;&gt;Nếu gửi thất bại: ghi log/retry; không tạo trùng tài khoản.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C026D3;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=14;" parent="1" vertex="1">
