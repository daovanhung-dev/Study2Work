@startuml
title STUDY2WORK - Activity - Lam quiz

start

partition "Hoc vien" {
  :Mo quiz;
  :Doc huong dan;
  :Bat dau lam quiz;
}

partition "He thong" {
  :Tai cau hoi;
  :Khoi tao thoi gian lam bai;
  :Hien thi cau hoi tuan tu;
}

repeat
partition "Hoc vien" {
  :Chon dap an;
  :Danh dau cau hoi can xem lai neu can;
  :Chuyen sang cau tiep theo;
}
partition "He thong" {
  :Luu dap an tam thoi;
  if (Het gio?) then (Co)
    :Tu dong nop quiz;
    break
  endif
}
repeat while (Con cau hoi?) is (Co)

partition "He thong" {
  :Cham diem tu dong;
  :Phan tich cau sai / cau dung;
  :Tinh diem tong;
  :Cap nhat tien do hoc tap;
  :Hien thi ket qua quiz;
}

stop
@enduml
