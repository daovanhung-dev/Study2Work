@startuml
title STUDY2WORK - Activity - Apply cong viec

start

partition "Hoc vien" {
  :Mo tin tuyen dung;
  :Doc thong tin cong viec;
  :Nhan ung tuyen;
  :Chon CV;
  :Nhap thu xin viec / thong tin bo sung;
  :Gui don ung tuyen;
}

partition "He thong" {
  :Kiem tra dieu kien ung tuyen;
  if (Hop le?) then (Co)
    :Kiem tra da ung tuyen chua;
    if (Chua ung tuyen?) then (Co)
      :Luu ho so ung tuyen;
      :Gan trang thai Da gui;
      :Thong bao ung tuyen thanh cong;
      :Gui thong bao cho doanh nghiep;
    else (Khong)
      :Thong bao da ton tai don ung tuyen;
    endif
  else (Khong)
    :Thong bao khong dat dieu kien hoac thieu ho so;
  endif
}

stop
@enduml
