@startuml 13_Git_PR_project_submission
title Study2Work - Activity - Git PR review và project submission
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

start
partition "Student / Mentor" {
  :Ghi PR review đã xác minh hoặc nộp project artifact;
  :Gửi yêu cầu tới API Study;
}
partition "FastAPI boundary" {
  :Tạo hoặc validate traceId;
  :Nhận API PROJECT-PR-001 + PROJECT-SUBMIT-001;
  :Validate task link, external PR id, artifact scan;
}
if (Request hợp lệ?) then (Có)
  partition "Security / Scope" {
    :JWT + team/project scope; verify provider payload;
    :Kiểm tra businessCode, moduleCode, traceId;
  }
  if (Được phép?) then (Có)
    partition "Domain policy" {
      :Áp dụng BR-PROJECT-003;
      :Kiểm tra state transition server-side;
      :project_submission versioned; task may move IN_REVIEW -> DONE;
    }
    if (Rule và trạng thái hợp lệ?) then (Có)
      partition "Data transaction" {
        :BEGIN TRANSACTION;
        :READ / WRITE git_repository_link, pull_request_review, task_comment, project_submission, file_asset, audit_log;
        :Ghi audit_log khi flow nhạy cảm;
        :COMMIT;
      }
      partition "Events / Worker" {
        :Publish ProjectSubmitted, TaskStatusChanged, NotificationRequested sau commit nếu có;
        :Worker xử lý retry-safe khi flow async;
      }
      partition "Response" {
        :Trả PR evidence hoặc project submission version;
        :Return standard envelope with businessCode, timestamp, traceId, data;
      }
    else (Không)
      partition "Business error" {
        :ROLLBACK nếu transaction đã mở;
        :E403 scope denied, E409 version conflict, E422 unsafe artifact;
        :Return safe error envelope;
      }
    endif
  else (Không)
    partition "Security error" {
      :Return E401/E403 envelope;
      :Không tiết lộ dữ liệu ngoài scope;
    }
  endif
else (Không)
  partition "Validation error" {
    :Return E422 envelope với field error an toàn;
  }
endif
stop
@enduml
