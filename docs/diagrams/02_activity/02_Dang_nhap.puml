@startuml
title STUDY2WORK - Activity - Dang nhap

start

partition "Khach truy cap" {
  :Truy cap trang dang nhap;
  :Nhap email / so dien thoai;
  :Nhap mat khau;
  :Chon ghi nho dang nhap (neu co);
  :Nhan dang nhap;
}

partition "He thong" {
  :Kiem tra du lieu dau vao;
  if (Hop le?) then (Co)
    :Tim tai khoan theo email / so dien thoai;
    if (Tai khoan ton tai?) then (Co)
      :Kiem tra trang thai tai khoan;
      if (Tai khoan da kich hoat?) then (Co)
        :So khop mat khau;
        if (Mat khau dung?) then (Co)
          :Kiem tra so lan dang nhap sai;
          :Khoi tao session / JWT;
          :Cap quyen theo vai tro;
          :Ghi nhan lich su dang nhap;
          :Chuyen den trang tong quan;
        else (Khong)
          :Tang so lan dang nhap sai;
          if (Vuot qua gioi han?) then (Co)
            :Tam khoa tai khoan / yeu cau doi mat khau;
          else (Khong)
            :Thong bao mat khau khong dung;
          endif
        endif
      else (Khong)
        :Thong bao tai khoan chua xac thuc;
        :Gui lai email / OTP xac thuc neu can;
      endif
    else (Khong)
      :Thong bao tai khoan khong ton tai;
    endif
  else (Khong)
    :Thong bao du lieu dang nhap khong hop le;
  endif
}

stop
@enduml
