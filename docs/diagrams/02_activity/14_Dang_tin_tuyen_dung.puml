@startuml
title STUDY2WORK - Activity - Dang tin tuyen dung

start

partition "Doanh nghiep" {
  :Dang nhap;
  :Mo chuc nang dang tin;
  :Nhap tieu de cong viec;
  :Nhap mo ta cong viec;
  :Nhap yeu cau ky nang;
  :Nhap dia diem / hinh thuc lam viec;
  :Nhap muc luong / phuc loi;
  :Chon han ung tuyen;
  :Gui dang tin;
}

partition "He thong" {
  :Kiem tra du lieu;
  if (Hop le?) then (Co)
    :Luu ban nhap;
    :Kiem duyet noi dung co ban;
    if (Dat yeu cau?) then (Co)
      :Cong khai tin tuyen dung;
      :Tao URL chia se;
      :Thong bao dang tin thanh cong;
    else (Khong)
      :Giu trang thai cho duyet;
      :Thong bao can chinh sua;
    endif
  else (Khong)
    :Hien thi loi nhap lieu;
  endif
}

stop
@enduml
