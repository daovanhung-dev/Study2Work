@startuml 05_Enroll_va_hoc_lesson
title Study2Work - Activity - Enroll và học lesson
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

start
partition "Student" {
  :Chọn learning path và mở lesson đã unlock;
  :Gửi yêu cầu tới API Study;
}
partition "FastAPI boundary" {
  :Tạo hoặc validate traceId;
  :Nhận API LEARN-PATH-002 + LEARN-LESSON-001;
  :Validate path published, lesson published, unlock rule;
}
if (Request hợp lệ?) then (Có)
  partition "Security / Scope" {
    :JWT + enrollment ownership;
    :Kiểm tra businessCode, moduleCode, traceId;
  }
  if (Được phép?) then (Có)
    partition "Domain policy" {
      :Áp dụng BR-LEARN-001, BR-LEARN-002;
      :Kiểm tra state transition server-side;
      :enrollment ENROLLED -> IN_PROGRESS; progress NOT_STARTED -> IN_PROGRESS;
    }
    if (Rule và trạng thái hợp lệ?) then (Có)
      partition "Data transaction" {
        :BEGIN TRANSACTION;
        :READ / WRITE learning_path, module, lesson, lesson_content, learning_path_enrollment, learning_progress, audit_log;
        :Ghi audit_log khi flow nhạy cảm;
        :COMMIT;
      }
      partition "Events / Worker" {
        :Publish LearningPathEnrolled, LessonStarted sau commit nếu có;
        :Worker xử lý retry-safe khi flow async;
      }
      partition "Response" {
        :Trả lesson content an toàn và trạng thái progress;
        :Return standard envelope with businessCode, timestamp, traceId, data;
      }
    else (Không)
      partition "Business error" {
        :ROLLBACK nếu transaction đã mở;
        :E403 not enrolled, E404 unpublished, E409 duplicate enrollment;
        :Return safe error envelope;
      }
    endif
  else (Không)
    partition "Security error" {
      :Return E401/E403 envelope;
      :Không tiết lộ dữ liệu ngoài scope;
    }
  endif
else (Không)
  partition "Validation error" {
    :Return E422 envelope với field error an toàn;
  }
endif
stop
@enduml
