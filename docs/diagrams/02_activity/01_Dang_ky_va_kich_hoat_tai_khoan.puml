@startuml 01_Dang_ky_va_kich_hoat_tai_khoan
title Study2Work - Activity - Đăng ký và kích hoạt tài khoản
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

start
partition "Khách" {
  :Nhập email/phone, password và xác nhận điều khoản;
  :Gửi yêu cầu tới API Study;
}
partition "FastAPI boundary" {
  :Tạo hoặc validate traceId;
  :Nhận API AUTH-REGISTER-001 + AUTH-VERIFY-001;
  :Validate format, password policy, token expiry;
}
if (Request hợp lệ?) then (Có)
  partition "Security / Scope" {
    :Không cần JWT; chống lộ thông tin tồn tại tài khoản;
    :Kiểm tra businessCode, moduleCode, traceId;
  }
  if (Được phép?) then (Có)
    partition "Domain policy" {
      :Áp dụng BR-AUTH-001, BR-AUTH-002, BR-AUTH-003;
      :Kiểm tra state transition server-side;
      :user.status PENDING -> ACTIVE;
    }
    if (Rule và trạng thái hợp lệ?) then (Có)
      partition "Data transaction" {
        :BEGIN TRANSACTION;
        :READ / WRITE user, user_role, verification_token, audit_log;
        :Ghi audit_log khi flow nhạy cảm;
        :COMMIT;
      }
      partition "Events / Worker" {
        :Publish UserRegistered, EmailVerified, NotificationRequested sau commit nếu có;
        :Worker xử lý retry-safe khi flow async;
      }
      partition "Response" {
        :Trả account active và session khởi tạo khi phù hợp;
        :Return standard envelope with businessCode, timestamp, traceId, data;
      }
    else (Không)
      partition "Business error" {
        :ROLLBACK nếu transaction đã mở;
        :E409 duplicate, E422 invalid, E500 hidden detail;
        :Return safe error envelope;
      }
    endif
  else (Không)
    partition "Security error" {
      :Return E401/E403 envelope;
      :Không tiết lộ dữ liệu ngoài scope;
    }
  endif
else (Không)
  partition "Validation error" {
    :Return E422 envelope với field error an toàn;
  }
endif
stop
@enduml
