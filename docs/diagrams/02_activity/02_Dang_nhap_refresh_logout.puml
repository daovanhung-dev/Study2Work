@startuml 02_Dang_nhap_refresh_logout
title Study2Work - Activity - Đăng nhập, refresh và logout
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

start
partition "Guest / User" {
  :Gửi credential, refresh token hoặc yêu cầu logout;
  :Gửi yêu cầu tới API Study;
}
partition "FastAPI boundary" {
  :Tạo hoặc validate traceId;
  :Nhận API AUTH-LOGIN-001 + AUTH-REFRESH-001 + AUTH-LOGOUT-001;
  :Validate credential shape, token hash, expiry;
}
if (Request hợp lệ?) then (Có)
  partition "Security / Scope" {
    :BCrypt verify, refresh rotation, revoke server-side;
    :Kiểm tra businessCode, moduleCode, traceId;
  }
  if (Được phép?) then (Có)
    partition "Domain policy" {
      :Áp dụng BR-AUTH-002, BR-AUTH-003;
      :Kiểm tra state transition server-side;
      :session active/revoked; refresh_token rotated/revoked;
    }
    if (Rule và trạng thái hợp lệ?) then (Có)
      partition "Data transaction" {
        :BEGIN TRANSACTION;
        :READ / WRITE user, session, refresh_token, audit_log;
        :Ghi audit_log khi flow nhạy cảm;
        :COMMIT;
      }
      partition "Events / Worker" {
        :Publish SessionCreated, SessionRevoked sau commit nếu có;
        :Worker xử lý retry-safe khi flow async;
      }
      partition "Response" {
        :Trả access token an toàn hoặc xác nhận logout;
        :Return standard envelope with businessCode, timestamp, traceId, data;
      }
    else (Không)
      partition "Business error" {
        :ROLLBACK nếu transaction đã mở;
        :E401 invalid, E403 suspended, E422 invalid token;
        :Return safe error envelope;
      }
    endif
  else (Không)
    partition "Security error" {
      :Return E401/E403 envelope;
      :Không tiết lộ dữ liệu ngoài scope;
    }
  endif
else (Không)
  partition "Validation error" {
    :Return E422 envelope với field error an toàn;
  }
endif
stop
@enduml
