@startuml 08_Assignment_submission_auto_grade
title Study2Work - Activity - Assignment submission và auto grade
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

start
partition "Student / System Worker" {
  :Student nộp artifact; worker chấm tự động sau commit;
  :Gửi yêu cầu tới API Study;
}
partition "FastAPI boundary" {
  :Tạo hoặc validate traceId;
  :Nhận API ASSESS-SUBMISSION-001 + ASSESS-GRADE-001;
  :Validate deadline, version, file scan, allowed attempts;
}
if (Request hợp lệ?) then (Có)
  partition "Security / Scope" {
    :JWT owner for submit; service identity for worker;
    :Kiểm tra businessCode, moduleCode, traceId;
  }
  if (Được phép?) then (Có)
    partition "Domain policy" {
      :Áp dụng BR-ASSESS-002, BR-ASSESS-003;
      :Kiểm tra state transition server-side;
      :submission DRAFT -> SUBMITTED/LATE_SUBMITTED -> GRADED;
    }
    if (Rule và trạng thái hợp lệ?) then (Có)
      partition "Data transaction" {
        :BEGIN TRANSACTION;
        :READ / WRITE assignment, assignment_submission, file_asset, review_report, skill_assessment, audit_log;
        :Ghi audit_log khi flow nhạy cảm;
        :COMMIT;
      }
      partition "Events / Worker" {
        :Publish AssignmentSubmitted, AutoGradingCompleted, SkillLevelUpdated sau commit nếu có;
        :Worker xử lý retry-safe khi flow async;
      }
      partition "Response" {
        :Trả submission version và grading status;
        :Return standard envelope with businessCode, timestamp, traceId, data;
      }
    else (Không)
      partition "Business error" {
        :ROLLBACK nếu transaction đã mở;
        :E403 owner denied, E409 immutable version, E422 unsafe file;
        :Return safe error envelope;
      }
    endif
  else (Không)
    partition "Security error" {
      :Return E401/E403 envelope;
      :Không tiết lộ dữ liệu ngoài scope;
    }
  endif
else (Không)
  partition "Validation error" {
    :Return E422 envelope với field error an toàn;
  }
endif
stop
@enduml
