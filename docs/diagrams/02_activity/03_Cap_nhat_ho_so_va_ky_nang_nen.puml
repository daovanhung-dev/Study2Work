@startuml 03_Cap_nhat_ho_so_va_ky_nang_nen
title Study2Work - Activity - Cập nhật hồ sơ và kỹ năng nền
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

start
partition "Student / Mentor" {
  :Mở trang hồ sơ và gửi thay đổi;
  :Gửi yêu cầu tới API Study;
}
partition "FastAPI boundary" {
  :Tạo hoặc validate traceId;
  :Nhận API USER-PROFILE-001 + USER-PROFILE-002 + USER-SKILL-001;
  :Validate profile fields, skill codes, visibility;
}
if (Request hợp lệ?) then (Có)
  partition "Security / Scope" {
    :JWT + owner only; không sửa hồ sơ người khác;
    :Kiểm tra businessCode, moduleCode, traceId;
  }
  if (Được phép?) then (Có)
    partition "Domain policy" {
      :Áp dụng BR-PLATFORM-001;
      :Kiểm tra state transition server-side;
      :profile updated; user_skill baseline updated;
    }
    if (Rule và trạng thái hợp lệ?) then (Có)
      partition "Data transaction" {
        :BEGIN TRANSACTION;
        :READ / WRITE user, profile, student_profile, mentor_profile, skill, user_skill, audit_log;
        :Ghi audit_log khi flow nhạy cảm;
        :COMMIT;
      }
      partition "Events / Worker" {
        :Publish ProfileUpdated, BaselineSkillUpdated sau commit nếu có;
        :Worker xử lý retry-safe khi flow async;
      }
      partition "Response" {
        :Trả hồ sơ của chính user và skill baseline;
        :Return standard envelope with businessCode, timestamp, traceId, data;
      }
    else (Không)
      partition "Business error" {
        :ROLLBACK nếu transaction đã mở;
        :E401, E403 owner denied, E404 skill missing, E422;
        :Return safe error envelope;
      }
    endif
  else (Không)
    partition "Security error" {
      :Return E401/E403 envelope;
      :Không tiết lộ dữ liệu ngoài scope;
    }
  endif
else (Không)
  partition "Validation error" {
    :Return E422 envelope với field error an toàn;
  }
endif
stop
@enduml
