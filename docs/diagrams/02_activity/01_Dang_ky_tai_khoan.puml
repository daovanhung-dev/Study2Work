@startuml
title STUDY2WORK - Activity - Dang ky tai khoan

start

partition "Khach truy cap" {
  :Truy cap trang dang ky;
  :Nhap ho ten;
  :Nhap email / so dien thoai;
  :Nhap mat khau;
  :Nhap xac nhan mat khau;
  :Chon vai tro dang ky (Hoc vien / Mentor / Doanh nghiep);
  :Dong y dieu khoan su dung;
}

partition "He thong" {
  :Hien thi form dang ky;
  :Kiem tra du lieu bat buoc;
  if (Du lieu hop le?) then (Co)
    :Kiem tra email / so dien thoai da ton tai;
    if (Da ton tai?) then (Co)
      :Thong bao tai khoan da ton tai;
      :Yeu cau dung email / so dien thoai khac;
      stop
    else (Khong)
      :Kiem tra mat khau va xac nhan mat khau;
      if (Mat khau khop?) then (Co)
        :Kiem tra do manh mat khau;
        if (Mat khau manh?) then (Co)
          :Tao tai khoan trang thai CHO_XAC_THUC;
          :Sinh ma OTP / link xac thuc;
          :Gui OTP / email xac thuc;
        else (Khong)
          :Thong bao mat khau yeu;
          stop
        endif
      else (Khong)
        :Thong bao mat khau xac nhan khong khop;
        stop
      endif
    endif
  else (Khong)
    :Hien thi loi nhap lieu;
    stop
  endif
}

partition "Khach truy cap" {
  :Mo email / nhan OTP;
  :Nhap OTP / click link xac thuc;
}

partition "He thong" {
  :Kiem tra OTP / link xac thuc;
  if (Xac thuc thanh cong?) then (Co)
    :Kich hoat tai khoan;
    :Tao ho so mac dinh;
    :Thong bao dang ky thanh cong;
  else (Khong)
    :Thong bao OTP khong hop le / het han;
    :Cho phep gui lai OTP;
  endif
}

stop
@enduml
