@startuml 06_Tien_do_bookmark_comment_live
title Study2Work - Activity - Tiến độ, bookmark, comment và live session
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

start
partition "Student / Mentor" {
  :Ghi vị trí học, toggle bookmark, tạo comment hoặc xem live;
  :Gửi yêu cầu tới API Study;
}
partition "FastAPI boundary" {
  :Tạo hoặc validate traceId;
  :Nhận API LEARN-PROGRESS-001 + LEARN-BOOKMARK-001 + LEARN-COMMENT-001 + LEARN-LIVE-001;
  :Validate lesson id, position, comment body, session time;
}
if (Request hợp lệ?) then (Có)
  partition "Security / Scope" {
    :JWT + enrollment or mentor assigned scope;
    :Kiểm tra businessCode, moduleCode, traceId;
  }
  if (Được phép?) then (Có)
    partition "Domain policy" {
      :Áp dụng BR-LEARN-002, BR-LEARN-003;
      :Kiểm tra state transition server-side;
      :progress IN_PROGRESS -> DONE when server rule passes;
    }
    if (Rule và trạng thái hợp lệ?) then (Có)
      partition "Data transaction" {
        :BEGIN TRANSACTION;
        :READ / WRITE learning_progress, bookmark, lesson_comment, live_session, notification, audit_log;
        :Ghi audit_log khi flow nhạy cảm;
        :COMMIT;
      }
      partition "Events / Worker" {
        :Publish LessonCompleted, NotificationRequested sau commit nếu có;
        :Worker xử lý retry-safe khi flow async;
      }
      partition "Response" {
        :Trả trạng thái progress/bookmark/comment/session;
        :Return standard envelope with businessCode, timestamp, traceId, data;
      }
    else (Không)
      partition "Business error" {
        :ROLLBACK nếu transaction đã mở;
        :E403 scope denied, E409 duplicate bookmark, E422 moderation input;
        :Return safe error envelope;
      }
    endif
  else (Không)
    partition "Security error" {
      :Return E401/E403 envelope;
      :Không tiết lộ dữ liệu ngoài scope;
    }
  endif
else (Không)
  partition "Validation error" {
    :Return E422 envelope với field error an toàn;
  }
endif
stop
@enduml
