@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam dpi 160
left to right direction
title STUDY2WORK - Mô-đun ĐÁNH-GIÁ (ASSESSMENT Module)

package "ĐÁNH-GIÁ / ASSESSMENT" {
  together {
    entity "bài_kiểm_tra\n(quizzes)" as quizzes {
      * id : BIGINT
      --
      course_id : BIGINT [khóa học]
      title : VARCHAR [tên quiz]
      time_limit_minutes : INT [giới hạn thời gian (phút)]
      passing_score : DECIMAL [điểm đạt]
      max_attempts : INT [số lần tối đa]
      status : VARCHAR [trạng thái]
    }

    entity "câu_hỏi_quiz\n(quiz_questions)" as quiz_questions {
      * id : BIGINT
      --
      quiz_id : BIGINT [quiz]
      question_text : LONGTEXT [nội dung câu hỏi]
      question_type : VARCHAR [loại câu hỏi]
      difficulty_level : VARCHAR [độ khó]
      score_weight : DECIMAL [trọng số]
      sort_order : INT [thứ tự]
    }

    entity "lựa_chọn_quiz\n(quiz_options)" as quiz_options {
      * id : BIGINT
      --
      question_id : BIGINT [câu hỏi]
      option_text : VARCHAR [nội dung lựa chọn]
      is_correct : BOOLEAN [đúng]
      sort_order : INT [thứ tự]
    }

    entity "lần_làm_quiz\n(quiz_attempts)" as quiz_attempts {
      * id : BIGINT
      --
      quiz_id : BIGINT [quiz]
      user_id : BIGINT [người dùng]
      started_at : DATETIME [bắt đầu lúc]
      submitted_at : DATETIME [nộp lúc]
      score : DECIMAL [điểm]
      passed : BOOLEAN [đạt]
      status : VARCHAR [trạng thái]
    }

    entity "trả_lời_quiz\n(quiz_answers)" as quiz_answers {
      * id : BIGINT
      --
      attempt_id : BIGINT [lần làm]
      question_id : BIGINT [câu hỏi]
      selected_option_id : BIGINT [lựa chọn]
      answer_text : LONGTEXT [nội dung trả lời]
      is_correct : BOOLEAN [đúng]
      score_earned : DECIMAL [điểm]
    }

    entity "bài_tập\n(assignments)" as assignments {
      * id : BIGINT
      --
      course_id : BIGINT [khóa học]
      title : VARCHAR [tên bài tập]
      due_at : DATETIME [hạn chót]
      allow_late_submission : BOOLEAN [cho phép nộp muộn]
      max_score : DECIMAL [điểm tối đa]
      status : VARCHAR [trạng thái]
    }

    entity "bài_nộp_tập\n(assignment_submissions)" as assignment_submissions {
      * id : BIGINT
      --
      assignment_id : BIGINT [bài tập]
      user_id : BIGINT [người dùng]
      content_text : LONGTEXT [nội dung]
      file_url : VARCHAR [URL file]
      submitted_at : DATETIME [nộp lúc]
      status : VARCHAR [trạng thái]
      score : DECIMAL [điểm]
      reviewed_by : BIGINT [người chấm]
      reviewed_at : DATETIME [chấm lúc]
    }

    entity "bài_lab_lập_trình\n(coding_labs)" as coding_labs {
      * id : BIGINT
      --
      course_id : BIGINT [khóa học]
      title : VARCHAR [tên lab]
      starter_code : LONGTEXT [mã khởi đầu]
      expected_output : LONGTEXT [đầu ra mong muốn]
      time_limit_minutes : INT [giới hạn thời gian (phút)]
      max_score : DECIMAL [điểm tối đa]
      status : VARCHAR [trạng thái]
    }

    entity "lần_làm_lab\n(coding_lab_attempts)" as coding_lab_attempts {
      * id : BIGINT
      --
      coding_lab_id : BIGINT [lab]
      user_id : BIGINT [người dùng]
      source_code : LONGTEXT [mã nguồn]
      submitted_at : DATETIME [nộp lúc]
      compile_status : VARCHAR [trạng thái biên dịch]
      test_status : VARCHAR [trạng thái test]
      score : DECIMAL [điểm]
      status : VARCHAR [trạng thái]
    }

    entity "xem_xét_code\n(code_reviews)" as code_reviews {
      * id : BIGINT
      --
      review_type : VARCHAR [loại xem xét]
      submission_id : BIGINT [bài nộp]
      lab_attempt_id : BIGINT [lần làm lab]
      mentor_user_id : BIGINT [người mentor]
      review_text : LONGTEXT [nhận xét]
      status : VARCHAR [trạng thái]
    }
  }
}

quizzes ||--o{ quiz_questions : "có"
quiz_questions ||--o{ quiz_options : "có"
quizzes ||--o{ quiz_attempts : "được làm"
quiz_attempts ||--o{ quiz_answers : "trả lời"
quiz_questions ||--o{ quiz_answers : "liên quan"
quiz_options ||--o{ quiz_answers : "được chọn"
assignments ||--o{ assignment_submissions : "được nộp"
coding_labs ||--o{ coding_lab_attempts : "được làm"
assignment_submissions ||--o{ code_reviews : "được xem xét"
coding_lab_attempts ||--o{ code_reviews : "được xem xét"

@enduml
