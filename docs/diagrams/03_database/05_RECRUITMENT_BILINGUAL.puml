@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam dpi 160
left to right direction
title STUDY2WORK - Mô-đun TUYỂN-DỤNG (RECRUITMENT Module)

package "TUYỂN-DỤNG / RECRUITMENT" {
  together {
    entity "công_ty\n(companies)" as companies {
      * id : BIGINT
      --
      owner_user_id : BIGINT [chủ sở hữu]
      name : VARCHAR [tên công ty]
      tax_code : VARCHAR [mã số thuế]
      website_url : VARCHAR [trang web]
      industry : VARCHAR [ngành]
      company_size : VARCHAR [quy mô]
      status : VARCHAR [trạng thái]
    }

    entity "thành_viên_công_ty\n(company_members)" as company_members {
      * company_id : BIGINT
      * user_id : BIGINT
      --
      member_role : VARCHAR [vai trò thành viên]
      joined_at : DATETIME [tham gia lúc]
    }

    entity "vị_trí_công_việc\n(jobs)" as jobs {
      * id : BIGINT
      --
      company_id : BIGINT [công ty]
      posted_by_user_id : BIGINT [người đăng]
      code : VARCHAR [mã code]
      title : VARCHAR [tên vị trí]
      slug : VARCHAR [URL slug]
      job_type : VARCHAR [loại công việc]
      work_mode : VARCHAR [hình thức làm]
      location : VARCHAR [địa điểm]
      salary_min : DECIMAL [lương tối thiểu]
      salary_max : DECIMAL [lương tối đa]
      currency : VARCHAR [tiền tệ]
      application_deadline : DATETIME [hạn chót nộp đơn]
      status : VARCHAR [trạng thái]
    }

    entity "kỹ_năng_vị_trí\n(job_skills)" as job_skills {
      * id : BIGINT
      --
      job_id : BIGINT [vị trí]
      skill_name : VARCHAR [tên kỹ năng]
      is_must_have : BOOLEAN [bắt buộc]
      sort_order : INT [thứ tự]
    }

    entity "hồ_sơ_ứng_viên\n(resumes)" as resumes {
      * id : BIGINT
      --
      user_id : BIGINT [người dùng]
      title : VARCHAR [tiêu đề]
      summary : LONGTEXT [tóm tắt]
      file_url : VARCHAR [URL file]
      is_default : BOOLEAN [mặc định]
      status : VARCHAR [trạng thái]
    }

    entity "học_vấn\n(resume_educations)" as resume_educations {
      * id : BIGINT
      --
      resume_id : BIGINT [hồ sơ]
      institution : VARCHAR [cơ sở giáo dục]
      major : VARCHAR [chuyên ngành]
      degree : VARCHAR [bằng cấp]
      start_date : DATE [ngày bắt đầu]
      end_date : DATE [ngày kết thúc]
      description : TEXT [mô tả]
      sort_order : INT [thứ tự]
    }

    entity "kinh_nghiệm_làm_việc\n(resume_experiences)" as resume_experiences {
      * id : BIGINT
      --
      resume_id : BIGINT [hồ sơ]
      company_name : VARCHAR [tên công ty]
      position_title : VARCHAR [chức danh]
      start_date : DATE [ngày bắt đầu]
      end_date : DATE [ngày kết thúc]
      description : TEXT [mô tả]
      sort_order : INT [thứ tự]
    }

    entity "kỹ_năng_hồ_sơ\n(resume_skills)" as resume_skills {
      * id : BIGINT
      --
      resume_id : BIGINT [hồ sơ]
      skill_name : VARCHAR [tên kỹ năng]
      proficiency_level : VARCHAR [cấp độ]
      sort_order : INT [thứ tự]
    }

    entity "đơn_ứng_tuyển\n(job_applications)" as job_applications {
      * id : BIGINT
      --
      job_id : BIGINT [vị trí]
      user_id : BIGINT [người dùng]
      resume_id : BIGINT [hồ sơ]
      cover_letter : LONGTEXT [thư xin việc]
      status : VARCHAR [trạng thái]
      applied_at : DATETIME [nộp đơn lúc]
      reviewed_at : DATETIME [xem xét lúc]
      reviewed_by : BIGINT [người xem xét]
    }
  }
}

companies ||--o{ company_members : "có thành viên"
companies ||--o{ jobs : "đăng"
jobs ||--o{ job_skills : "yêu cầu"
resumes ||--o{ resume_educations : "có"
resumes ||--o{ resume_experiences : "có"
resumes ||--o{ resume_skills : "có"
jobs ||--o{ job_applications : "nhận"
resumes ||--o{ job_applications : "sử dụng"

@enduml
