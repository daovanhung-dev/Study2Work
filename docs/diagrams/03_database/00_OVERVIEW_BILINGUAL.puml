@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam dpi 160
left to right direction
title STUDY2WORK - Tổng quan CSDL (Database Overview) - Song ngữ VN/EN

package "XÁC-THỰC\n(AUTH)" as AUTH
package "HỌC-TẬP\n(LEARNING)" as LEARNING
package "VỊ-TRÍ & LỘ-TRÌNH\n(PLACEMENT & AI ROADMAP)" as ROADMAP
package "ĐÁNH-GIÁ\n(ASSESSMENT)" as ASSESSMENT
package "TUYỂN-DỤNG\n(RECRUITMENT)" as RECRUITMENT
package "THANH-TOÁN\n(PAYMENT)" as PAYMENT

AUTH -[hidden]right-> LEARNING
LEARNING -[hidden]right-> ROADMAP
ROADMAP -[hidden]down-> ASSESSMENT
ASSESSMENT -[hidden]right-> RECRUITMENT
RECRUITMENT -[hidden]right-> PAYMENT

AUTH .. PAYMENT : "người dùng"
AUTH .. LEARNING : "người dùng"
AUTH .. ROADMAP : "người dùng"
LEARNING .. ROADMAP : "khóa học"
LEARNING .. ASSESSMENT : "khóa học"
ASSESSMENT .. RECRUITMENT : "người dùng"
RECRUITMENT .. PAYMENT : "đơn hàng"

note right of AUTH
  Quản lý tài khoản, vai trò, phiên đăng nhập
  Manage accounts, roles, sessions
end note

note right of LEARNING
  Quản lý khóa học, bài học, tài liệu
  Manage courses, lessons, resources
end note

note right of ROADMAP
  Kiểm tra đầu vào, tạo lộ trình học
  Placement testing, AI-powered roadmaps
end note

note right of ASSESSMENT
  Quiz, bài tập, Coding Lab, xem xét code
  Quizzes, assignments, coding labs, reviews
end note

note right of RECRUITMENT
  Quản lý công ty, vị trí, hồ sơ, ứng tuyển
  Manage companies, jobs, resumes, applications
end note

note right of PAYMENT
  Quản lý đơn hàng, thanh toán, mã giảm giá
  Manage orders, payments, coupons
end note

@enduml
