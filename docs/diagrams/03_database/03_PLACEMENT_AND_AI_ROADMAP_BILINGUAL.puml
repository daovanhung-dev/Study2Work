@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam dpi 160
left to right direction
title STUDY2WORK - Mô-đun VỊ-TRÍ & LỘ-TRÌNH AI (PLACEMENT & AI ROADMAP Module)

package "VỊ-TRÍ & LỘ-TRÌNH AI / PLACEMENT & AI ROADMAP" {
  together {
    entity "kiểm_tra_đầu_vào\n(placement_tests)" as placement_tests {
      * id : BIGINT
      --
      code : VARCHAR [mã code]
      title : VARCHAR [tên kiểm tra]
      duration_minutes : INT [thời gian (phút)]
      passing_score : DECIMAL [điểm đạt]
      status : VARCHAR [trạng thái]
    }

    entity "câu_hỏi_đầu_vào\n(placement_questions)" as placement_questions {
      * id : BIGINT
      --
      test_id : BIGINT [kiểm tra]
      question_text : LONGTEXT [nội dung câu hỏi]
      question_type : VARCHAR [loại câu hỏi]
      difficulty_level : VARCHAR [độ khó]
      score_weight : DECIMAL [trọng số]
      sort_order : INT [thứ tự]
    }

    entity "lựa_chọn_câu_hỏi\n(placement_question_options)" as placement_question_options {
      * id : BIGINT
      --
      question_id : BIGINT [câu hỏi]
      option_text : VARCHAR [nội dung lựa chọn]
      is_correct : BOOLEAN [đúng]
      sort_order : INT [thứ tự]
    }

    entity "lần_làm_kiểm_tra\n(placement_attempts)" as placement_attempts {
      * id : BIGINT
      --
      test_id : BIGINT [kiểm tra]
      user_id : BIGINT [người dùng]
      started_at : DATETIME [bắt đầu lúc]
      submitted_at : DATETIME [nộp lúc]
      raw_score : DECIMAL [điểm thô]
      percentile : DECIMAL [phần trăm]
      result_level : VARCHAR [cấp độ kết quả]
      status : VARCHAR [trạng thái]
    }

    entity "câu_trả_lời\n(placement_attempt_answers)" as placement_attempt_answers {
      * id : BIGINT
      --
      attempt_id : BIGINT [lần làm]
      question_id : BIGINT [câu hỏi]
      selected_option_id : BIGINT [lựa chọn]
      answer_text : LONGTEXT [nội dung trả lời]
      is_correct : BOOLEAN [đúng]
      score_earned : DECIMAL [điểm]
    }

    entity "lộ_trình_học\n(roadmaps)" as roadmaps {
      * id : BIGINT
      --
      user_id : BIGINT [người dùng]
      source_attempt_id : BIGINT [lần kiểm tra]
      target_role : VARCHAR [vị trí mục tiêu]
      current_level : VARCHAR [cấp độ hiện tại]
      goal_text : VARCHAR [mục tiêu]
      ai_model : VARCHAR [mô hình AI]
      status : VARCHAR [trạng thái]
    }

    entity "bước_lộ_trình\n(roadmap_steps)" as roadmap_steps {
      * id : BIGINT
      --
      roadmap_id : BIGINT [lộ trình]
      step_order : INT [thứ tự bước]
      step_type : VARCHAR [loại bước]
      title : VARCHAR [tiêu đề]
      description : VARCHAR [mô tả]
      estimated_hours : DECIMAL [giờ ước tính]
      course_id : BIGINT [khóa học]
      lesson_id : BIGINT [bài học]
      status : VARCHAR [trạng thái]
    }
  }
}

placement_tests ||--o{ placement_questions : "có"
placement_questions ||--o{ placement_question_options : "có"
placement_tests ||--o{ placement_attempts : "được làm"
placement_attempts ||--o{ placement_attempt_answers : "trả lời"
placement_questions ||--o{ placement_attempt_answers : "liên quan"
placement_question_options ||--o{ placement_attempt_answers : "được chọn"
placement_attempts ||--o{ roadmaps : "tạo"
roadmaps ||--o{ roadmap_steps : "có"

@enduml
