@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam dpi 160
left to right direction
title STUDY2WORK - Mô-đun THANH-TOÁN (PAYMENT Module)

package "THANH-TOÁN / PAYMENT" {
  together {
    entity "mã_giảm_giá\n(coupons)" as coupons {
      * id : BIGINT
      --
      code : VARCHAR [mã code]
      discount_type : VARCHAR [loại giảm giá]
      discount_value : DECIMAL [giá trị giảm]
      start_at : DATETIME [bắt đầu lúc]
      end_at : DATETIME [kết thúc lúc]
      status : VARCHAR [trạng thái]
    }

    entity "đơn_hàng\n(orders)" as orders {
      * id : BIGINT
      --
      order_no : VARCHAR [số đơn hàng]
      user_id : BIGINT [người dùng]
      coupon_id : BIGINT [mã giảm giá]
      subtotal_amount : DECIMAL [tổng cộng]
      discount_amount : DECIMAL [tổng giảm]
      total_amount : DECIMAL [tổng thanh toán]
      currency : VARCHAR [tiền tệ]
      status : VARCHAR [trạng thái]
      paid_at : DATETIME [thanh toán lúc]
    }

    entity "mặt_hàng_đơn\n(order_items)" as order_items {
      * id : BIGINT
      --
      order_id : BIGINT [đơn hàng]
      item_type : VARCHAR [loại mặt hàng]
      item_id : BIGINT [ID mặt hàng]
      item_name : VARCHAR [tên mặt hàng]
      quantity : INT [số lượng]
      unit_price : DECIMAL [giá đơn vị]
      total_price : DECIMAL [tổng giá]
    }

    entity "thanh_toán\n(payments)" as payments {
      * id : BIGINT
      --
      order_id : BIGINT [đơn hàng]
      gateway : VARCHAR [cổng thanh toán]
      gateway_transaction_id : VARCHAR [ID giao dịch]
      payment_method : VARCHAR [phương thức thanh toán]
      amount : DECIMAL [số tiền]
      currency : VARCHAR [tiền tệ]
      status : VARCHAR [trạng thái]
      paid_at : DATETIME [thanh toán lúc]
    }
  }
}

coupons ||--o{ orders : "áp dụng"
orders ||--o{ order_items : "chứa"
orders ||--o{ payments : "có"

@enduml
