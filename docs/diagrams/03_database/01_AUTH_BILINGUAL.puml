@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam dpi 160
left to right direction
title STUDY2WORK - Mô-đun XÁC-THỰC (AUTH Module)

package "XÁC-THỰC / AUTH" {
  together {
    entity "người_dùng\n(users)" as users {
      * id : BIGINT
      --
      full_name : VARCHAR [họ tên]
      email : VARCHAR [email]
      phone : VARCHAR [điện thoại]
      password_hash : VARCHAR [mã hóa mật khẩu]
      primary_role : VARCHAR [vai trò chính]
      status : VARCHAR [trạng thái]
      created_at : DATETIME [ngày tạo]
      updated_at : DATETIME [ngày cập nhật]
    }

    entity "vai_trò\n(roles)" as roles {
      * id : BIGINT
      --
      code : VARCHAR [mã code]
      name : VARCHAR [tên vai trò]
    }

    entity "quyền_người_dùng\n(user_roles)" as user_roles {
      * user_id : BIGINT
      * role_id : BIGINT
      --
      assigned_at : DATETIME [ngày gán]
    }

    entity "hồ_sơ_người_dùng\n(user_profiles)" as user_profiles {
      * user_id : BIGINT
      --
      headline : VARCHAR [tiêu đề hồ sơ]
      bio : TEXT [giới thiệu bản thân]
      location : VARCHAR [địa điểm]
      website_url : VARCHAR [trang web]
      github_url : VARCHAR [GitHub]
      linkedin_url : VARCHAR [LinkedIn]
      education_level : VARCHAR [trình độ học vấn]
      years_experience : TINYINT [năm kinh nghiệm]
      skills_summary : TEXT [tóm tắt kỹ năng]
    }

    entity "mã_xác_thực\n(user_verification_tokens)" as user_verification_tokens {
      * id : BIGINT
      --
      user_id : BIGINT
      token_type : VARCHAR [loại token]
      token_hash : VARCHAR [mã hash token]
      sent_to : VARCHAR [gửi đến]
      expires_at : DATETIME [hết hạn lúc]
      used_at : DATETIME [sử dụng lúc]
    }

    entity "phiên_đăng_nhập\n(user_sessions)" as user_sessions {
      * id : BIGINT
      --
      user_id : BIGINT
      refresh_token_hash : VARCHAR [mã hash refresh token]
      device_name : VARCHAR [tên thiết bị]
      expires_at : DATETIME [hết hạn lúc]
      revoked_at : DATETIME [hủy lúc]
    }

    entity "thông_báo\n(notifications)" as notifications {
      * id : BIGINT
      --
      user_id : BIGINT
      type : VARCHAR [loại thông báo]
      title : VARCHAR [tiêu đề]
      message : TEXT [nội dung]
      entity_type : VARCHAR [loại đối tượng]
      entity_id : BIGINT [ID đối tượng]
      is_read : BOOLEAN [đã đọc]
    }

    entity "nhật_ký_quản_trị\n(admin_audit_logs)" as admin_audit_logs {
      * id : BIGINT
      --
      actor_user_id : BIGINT [người thực hiện]
      action : VARCHAR [hành động]
      entity_type : VARCHAR [loại đối tượng]
      entity_id : BIGINT [ID đối tượng]
      before_data : JSON [dữ liệu trước]
      after_data : JSON [dữ liệu sau]
      created_at : DATETIME [ngày tạo]
    }
  }
}

users ||--o{ user_roles : "có quyền"
roles ||--o{ user_roles : "được gán"
users ||--|| user_profiles : "có hồ sơ"
users ||--o{ user_verification_tokens : "có mã xác thực"
users ||--o{ user_sessions : "có phiên"
users ||--o{ notifications : "nhận"
users ||--o{ admin_audit_logs : "thực hiện"

@enduml
