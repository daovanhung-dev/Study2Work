@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam dpi 160
left to right direction
title STUDY2WORK - PLACEMENT & AI ROADMAP Module

package "PLACEMENT & AI ROADMAP" {
  together {
    entity "placement_tests" as placement_tests {
      * id : BIGINT
      --
      code : VARCHAR
      title : VARCHAR
      duration_minutes : INT
      passing_score : DECIMAL
      status : VARCHAR
    }

    entity "placement_questions" as placement_questions {
      * id : BIGINT
      --
      test_id : BIGINT
      question_text : LONGTEXT
      question_type : VARCHAR
      difficulty_level : VARCHAR
      score_weight : DECIMAL
      sort_order : INT
    }

    entity "placement_question_options" as placement_question_options {
      * id : BIGINT
      --
      question_id : BIGINT
      option_text : VARCHAR
      is_correct : BOOLEAN
      sort_order : INT
    }

    entity "placement_attempts" as placement_attempts {
      * id : BIGINT
      --
      test_id : BIGINT
      user_id : BIGINT
      started_at : DATETIME
      submitted_at : DATETIME
      raw_score : DECIMAL
      percentile : DECIMAL
      result_level : VARCHAR
      status : VARCHAR
    }

    entity "placement_attempt_answers" as placement_attempt_answers {
      * id : BIGINT
      --
      attempt_id : BIGINT
      question_id : BIGINT
      selected_option_id : BIGINT
      answer_text : LONGTEXT
      is_correct : BOOLEAN
      score_earned : DECIMAL
    }

    entity "roadmaps" as roadmaps {
      * id : BIGINT
      --
      user_id : BIGINT
      source_attempt_id : BIGINT
      target_role : VARCHAR
      current_level : VARCHAR
      goal_text : VARCHAR
      ai_model : VARCHAR
      status : VARCHAR
    }

    entity "roadmap_steps" as roadmap_steps {
      * id : BIGINT
      --
      roadmap_id : BIGINT
      step_order : INT
      step_type : VARCHAR
      title : VARCHAR
      description : VARCHAR
      estimated_hours : DECIMAL
      course_id : BIGINT
      lesson_id : BIGINT
      status : VARCHAR
    }
  }
}

placement_tests ||--o{ placement_questions
placement_questions ||--o{ placement_question_options
placement_tests ||--o{ placement_attempts
placement_attempts ||--o{ placement_attempt_answers
placement_questions ||--o{ placement_attempt_answers
placement_question_options ||--o{ placement_attempt_answers : selected
placement_attempts ||--o{ roadmaps
roadmaps ||--o{ roadmap_steps

@enduml
