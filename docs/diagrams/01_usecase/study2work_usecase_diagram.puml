@startuml Study2Work_Study_UseCase_Canonical
left to right direction
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1D4ED8
}
skinparam actor {
  BackgroundColor #ECFEFF
  BorderColor #0891B2
}
title Study2Work - Use Case Canonical - Study Scope

actor "Khách" as Guest
actor "Học viên" as Student
actor "Mentor" as Mentor
actor "Quản trị viên" as Admin
actor "System Worker" as Worker
actor "AI Service" as AI
actor "Notification Service" as Noti
actor "Git Provider" as Git
actor "Object Storage" as Storage
actor "Grader Runner" as Runner

rectangle "Study2Work Study Platform" {
  package "Identity & Profile" as P_AUTH {
    usecase "Đăng ký tài khoản" as UC_Register
    usecase "Xác thực email" as UC_Verify
    usecase "Đăng nhập / OAuth" as UC_Login
    usecase "Refresh token" as UC_Refresh
    usecase "Đăng xuất" as UC_Logout
    usecase "Quên mật khẩu" as UC_Reset
    usecase "Xem hồ sơ của tôi" as UC_Me
    usecase "Cập nhật hồ sơ" as UC_Profile
    usecase "Khai báo kỹ năng nền" as UC_Skills
    usecase "Quản lý vai trò và phạm vi mentor" as UC_RBAC
  }

  package "Learning Journey" as P_LEARN {
    usecase "Làm placement test" as UC_Placement
    usecase "Nhận gợi ý lộ trình" as UC_PathSuggest
    usecase "Enroll learning path" as UC_Enroll
    usecase "Xem lộ trình và dashboard" as UC_Dashboard
    usecase "Mở lesson đã unlock" as UC_Lesson
    usecase "Ghi nhận tiến độ lesson" as UC_Progress
    usecase "Bookmark lesson" as UC_Bookmark
    usecase "Thảo luận lesson" as UC_Comment
    usecase "Xem live session" as UC_Live
  }

  package "Practice & Assessment" as P_ASSESS {
    usecase "Làm quiz attempt" as UC_Quiz
    usecase "Nộp assignment / code" as UC_Submission
    usecase "Chấm tự động async" as UC_AutoGrade
    usecase "Mentor review theo rubric" as UC_Review
    usecase "Yêu cầu sửa bài" as UC_Revision
    usecase "Xem practice history" as UC_History
    usecase "Xem skill matrix" as UC_Matrix
  }

  package "Project & Teamwork" as P_PROJECT {
    usecase "Tạo team project" as UC_CreateTeam
    usecase "Tham gia team" as UC_JoinTeam
    usecase "Tạo sprint" as UC_Sprint
    usecase "Tạo task" as UC_Task
    usecase "Chuyển trạng thái task" as UC_TaskStatus
    usecase "Ghi work log" as UC_WorkLog
    usecase "Ghi PR review" as UC_PR
    usecase "Nộp project artifact" as UC_ProjectSubmit
    usecase "Team chat và file sharing" as UC_TeamCollab
  }

  package "AI Learning Support" as P_AI {
    usecase "AI roadmap suggestion" as UC_AIRoadmap
    usecase "AI code explanation" as UC_AICode
    usecase "AI debugging hints" as UC_AIDebug
    usecase "Learning insight" as UC_AIInsight
  }

  package "Community, Notification & Platform" as P_PLATFORM {
    usecase "Đăng ký workshop" as UC_EventReg
    usecase "Xem notification feed" as UC_NotiFeed
    usecase "Gửi notification async" as UC_SendNoti
    usecase "Quản lý user / mentor" as UC_AdminUser
    usecase "Quản lý content học" as UC_AdminContent
    usecase "Quản lý rubric" as UC_AdminRubric
    usecase "Quản lý skill taxonomy" as UC_AdminSkill
    usecase "Quản lý setting / feature flag" as UC_AdminSetting
    usecase "Moderation và audit" as UC_Audit
    usecase "Xem Study analytics" as UC_Analytics
  }
}

Guest --> UC_Register
Guest --> UC_Verify
Guest --> UC_Login
Guest --> UC_Reset

Student --> UC_Me
Student --> UC_Profile
Student --> UC_Skills
Student --> UC_Placement
Student --> UC_Enroll
Student --> UC_Dashboard
Student --> UC_Lesson
Student --> UC_Progress
Student --> UC_Bookmark
Student --> UC_Comment
Student --> UC_Live
Student --> UC_Quiz
Student --> UC_Submission
Student --> UC_History
Student --> UC_Matrix
Student --> UC_CreateTeam
Student --> UC_JoinTeam
Student --> UC_Task
Student --> UC_TaskStatus
Student --> UC_WorkLog
Student --> UC_PR
Student --> UC_ProjectSubmit
Student --> UC_TeamCollab
Student --> UC_AIRoadmap
Student --> UC_AICode
Student --> UC_AIDebug
Student --> UC_AIInsight
Student --> UC_EventReg
Student --> UC_NotiFeed

Mentor --> UC_Me
Mentor --> UC_Profile
Mentor --> UC_Live
Mentor --> UC_Review
Mentor --> UC_Revision
Mentor --> UC_Matrix
Mentor --> UC_CreateTeam
Mentor --> UC_Sprint
Mentor --> UC_Task
Mentor --> UC_TaskStatus
Mentor --> UC_PR
Mentor --> UC_TeamCollab
Mentor --> UC_AICode
Mentor --> UC_AIInsight
Mentor --> UC_NotiFeed

Admin --> UC_RBAC
Admin --> UC_AdminUser
Admin --> UC_AdminContent
Admin --> UC_AdminRubric
Admin --> UC_AdminSkill
Admin --> UC_AdminSetting
Admin --> UC_Audit
Admin --> UC_Analytics
Admin --> UC_SendNoti

Worker --> UC_AutoGrade
Worker --> UC_SendNoti
AI --> UC_AIRoadmap
AI --> UC_AICode
AI --> UC_AIDebug
AI --> UC_AIInsight
Noti --> UC_SendNoti
Git --> UC_PR
Storage --> UC_Submission
Storage --> UC_ProjectSubmit
Runner --> UC_AutoGrade

UC_Register ..> UC_Verify : <<include>>
UC_Login ..> UC_Refresh : <<extend>>
UC_Placement ..> UC_PathSuggest : <<include>>
UC_Enroll ..> UC_Dashboard : <<include>>
UC_Lesson ..> UC_Progress : <<include>>
UC_Submission ..> UC_AutoGrade : <<include>>
UC_AutoGrade ..> UC_Matrix : <<include>>
UC_Review ..> UC_Matrix : <<include>>
UC_TaskStatus ..> UC_WorkLog : <<extend>>
UC_PR ..> UC_TaskStatus : <<extend>>
UC_AIRoadmap ..> UC_AIInsight : <<include>>
UC_AICode ..> UC_AIInsight : <<include>>
UC_AdminContent ..> UC_Audit : <<include>>
UC_AdminRubric ..> UC_Audit : <<include>>
UC_RBAC ..> UC_Audit : <<include>>
UC_SendNoti ..> UC_NotiFeed : <<include>>

note right of UC_Submission
Pre: Student owns enrollment and assignment is available.
Post: versioned evidence is stored and grading is queued.
Rules: BR-ASSESS-002, BR-ASSESS-003.
end note

note right of UC_Review
Pre: Mentor has assigned scope.
Post: review snapshot and skill evidence are recorded.
Rules: BR-MENTOR-001, BR-MENTOR-002.
end note

note bottom of P_PLATFORM
Every protected use case checks authentication, RBAC,
ownership or scope, validation, traceId and audit when required.
Rule: BR-PLATFORM-001.
end note

@enduml
