@startuml
title STUDY2WORK - Sequence - Xem khóa học và đăng ký
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Học viên" as LEARNER
boundary "Web/App UI" as UI

box "API Layer" #F9FBFD
control "CourseController" as COURSE_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "Validation Layer" as VALIDATOR
control "CourseService" as COURSE_SERVICE
control "EnrollmentService" as ENROLLMENT_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "CourseRepository" as COURSE_REPO
entity "EnrollmentRepository" as ENROLLMENT_REPO
end box

database "MySQL DB" as DB

== Xem chi tiết khóa học ==

LEARNER -> UI : Mở chi tiết khóa học
activate UI

UI -> COURSE_CONTROLLER : GET /api/v1/courses/{id}
activate COURSE_CONTROLLER

note right of COURSE_CONTROLLER
Expected Response:
200 OK
401 UNAUTHORIZED
404 NOT_FOUND
500 INTERNAL_SERVER_ERROR
end note

COURSE_CONTROLLER -> COURSE_SERVICE : getCourseDetail(course_id)
activate COURSE_SERVICE

COURSE_SERVICE -> COURSE_REPO : findCourse(course_id)
activate COURSE_REPO

note right of COURSE_REPO
Repository Method:
findCourse(courseId)

Input:
- course_id

Output:
- CourseEntity?
end note

COURSE_REPO -> DB : SELECT courses, course_modules, course_lessons, lesson_resources WHERE course_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ courses, course_modules, course_lessons, lesson_resources

Purpose:
- tải nội dung khóa học chi tiết

Returned Fields:
- course_id
- course_name
- description
- price
- rating
- instructor_id
- status
end note

DB --> COURSE_REPO : course detail
deactivate DB
COURSE_REPO --> COURSE_SERVICE : course detail
deactivate COURSE_REPO

COURSE_SERVICE --> COURSE_CONTROLLER : CourseDetailResponseDTO
deactivate COURSE_SERVICE

note right of COURSE_CONTROLLER
Response DTO:
{
  course_id,
  course_name,
  description,
  price,
  modules[],
  lessons[],
  resources[]
}
end note

COURSE_CONTROLLER --> UI : 200 OK
deactivate COURSE_CONTROLLER
UI --> LEARNER : Hiển thị nội dung khóa học
deactivate UI

== Đăng ký khóa học ==

LEARNER -> UI : Nhấn đăng ký học
activate UI

UI -> COURSE_CONTROLLER : POST /api/v1/courses/{id}/enroll
activate COURSE_CONTROLLER

note right of COURSE_CONTROLLER
Request DTO:
{
  course_id
}

Expected Response:
200 OK / 201 CREATED
401 UNAUTHORIZED
403 FORBIDDEN
404 NOT_FOUND
409 CONFLICT
422 VALIDATION_ERROR
500 INTERNAL_SERVER_ERROR
end note

== VALIDATION FLOW ==

COURSE_CONTROLLER -> VALIDATOR : validateEnrollRequest(dto)
activate VALIDATOR

note right of VALIDATOR
Validation Flow:
- required fields
- course exists
- user not enrolled
- payment status if paid
end note

alt Dữ liệu không hợp lệ
    VALIDATOR --> COURSE_CONTROLLER : ValidationException
    COURSE_CONTROLLER --> UI : 422 VALIDATION_ERROR
    UI --> LEARNER : Hiển thị lỗi validate
    deactivate VALIDATOR
else Dữ liệu hợp lệ
    VALIDATOR --> COURSE_CONTROLLER : validatedDto
    deactivate VALIDATOR

    == BUSINESS FLOW ==

    COURSE_CONTROLLER -> ENROLLMENT_SERVICE : enroll(user_id, course_id)
    activate ENROLLMENT_SERVICE

    alt Khóa học miễn phí hoặc đã mua
        group BEGIN TRANSACTION

            ENROLLMENT_SERVICE -> ENROLLMENT_REPO : createEnrollment(user_id, course_id)
            activate ENROLLMENT_REPO

            note right of ENROLLMENT_REPO
            Repository Method:
            createEnrollment(userId, courseId)

            Input:
            - user_id
            - course_id
            - enrolled_at

            Output:
            - enrollment_entity
            end note

            ENROLLMENT_REPO -> DB : INSERT INTO course_enrollments (user_id, course_id, enrolled_at, status)
            activate DB

            note right of DB
            DATABASE ACTION:
            WRITE course_enrollments

            Purpose:
            - tạo bản ghi đăng ký

            Insert Fields:
            - enrollment_id
            - user_id
            - course_id
            - enrolled_at
            - status = ACTIVE
            end note

            DB --> ENROLLMENT_REPO : enrollment_id
            deactivate DB
            ENROLLMENT_REPO --> ENROLLMENT_SERVICE : enrollment entity
            deactivate ENROLLMENT_REPO

        end

        ENROLLMENT_SERVICE --> COURSE_CONTROLLER : EnrollmentResponseDTO
        deactivate ENROLLMENT_SERVICE

        note right of COURSE_CONTROLLER
        Response DTO:
        {
          enrollment_id,
          course_id,
          status,
          enrolled_at
        }
        end note

        COURSE_CONTROLLER --> UI : 201 CREATED
        deactivate COURSE_CONTROLLER
        UI --> LEARNER : Mở quyền học
        deactivate UI

    else Khóa học trả phí (chưa thanh toán)
        ENROLLMENT_SERVICE --> COURSE_CONTROLLER : PaymentRequiredException
        deactivate ENROLLMENT_SERVICE
        COURSE_CONTROLLER --> UI : 402 PAYMENT_REQUIRED
        deactivate COURSE_CONTROLLER
        UI --> LEARNER : Chuyển sang thanh toán
        deactivate UI
    end
end

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    ENROLLMENT_SERVICE -> ENROLLMENT_SERVICE : catch(SystemException)

    note right of ENROLLMENT_SERVICE
    Rollback Conditions:
    - DB insert thất bại
    - course status invalid
    - user already enrolled

    Action:
    - rollback transaction
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
