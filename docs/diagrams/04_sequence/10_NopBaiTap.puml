@startuml
title STUDY2WORK - Sequence - Nộp bài tập
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Học viên" as LEARNER
boundary "Web/App UI" as UI

box "API Layer" #F9FBFD
control "AssignmentController" as ASSIGNMENT_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "Validation Layer" as VALIDATOR
control "AssignmentService" as ASSIGNMENT_SERVICE
control "NotificationService" as NOTIFY_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "AssignmentRepository" as ASSIGNMENT_REPO
entity "SubmissionRepository" as SUBMISSION_REPO
entity "NotificationRepository" as NOTIFICATION_REPO
end box

database "MySQL DB" as DB

== Nộp bài tập ==

LEARNER -> UI : Chuẩn bị nộp bài
activate UI

UI -> ASSIGNMENT_CONTROLLER : POST /api/v1/assignments/{id}/submit
activate ASSIGNMENT_CONTROLLER

note right of ASSIGNMENT_CONTROLLER
Request DTO:
{
  assignment_id,
  submission_content,
  file_urls
}

Expected Response:
200 OK / 201 CREATED
401 UNAUTHORIZED
403 FORBIDDEN
404 NOT_FOUND
422 VALIDATION_ERROR
409 CONFLICT
500 INTERNAL_SERVER_ERROR
end note

== VALIDATION FLOW ==

ASSIGNMENT_CONTROLLER -> VALIDATOR : validateSubmissionRequest(dto)
activate VALIDATOR

note right of VALIDATOR
Validation Flow:
- required fields
- assignment exists
- deadline check
- content format
- file size limit
end note

alt Dữ liệu không hợp lệ
    VALIDATOR --> ASSIGNMENT_CONTROLLER : ValidationException
    ASSIGNMENT_CONTROLLER --> UI : 422 VALIDATION_ERROR
    UI --> LEARNER : Hiển thị lỗi validate
    deactivate VALIDATOR
else Dữ liệu hợp lệ
    VALIDATOR --> ASSIGNMENT_CONTROLLER : validatedDto
    deactivate VALIDATOR

    == BUSINESS FLOW ==

    ASSIGNMENT_CONTROLLER -> ASSIGNMENT_SERVICE : submitAssignment(user_id, assignment_id, payload)
    activate ASSIGNMENT_SERVICE

    ASSIGNMENT_SERVICE -> ASSIGNMENT_REPO : getAssignment(assignment_id)
    activate ASSIGNMENT_REPO

    note right of ASSIGNMENT_REPO
    Repository Method:
    getAssignment(assignmentId)

    Input:
    - assignment_id

    Output:
    - AssignmentEntity?
    end note

    ASSIGNMENT_REPO -> DB : SELECT assignments WHERE assignment_id = ?
    activate DB

    note right of DB
    DATABASE ACTION:
    READ assignments

    Purpose:
    - tải thông tin bài tập

    Returned Fields:
    - assignment_id
    - course_id
    - title
    - description
    - deadline
    - status
    end note

    DB --> ASSIGNMENT_REPO : assignment
    deactivate DB
    ASSIGNMENT_REPO --> ASSIGNMENT_SERVICE : assignment entity
    deactivate ASSIGNMENT_REPO

    alt Deadline đã qua
        ASSIGNMENT_SERVICE --> ASSIGNMENT_CONTROLLER : ConflictException(DEADLINE_EXPIRED)
        ASSIGNMENT_CONTROLLER --> UI : 409 CONFLICT
        UI --> LEARNER : Hiển thị "Đã hết hạn nộp"
    else Còn hạn nộp

        group BEGIN TRANSACTION

            ASSIGNMENT_SERVICE -> SUBMISSION_REPO : findExistingSubmission(user_id, assignment_id)
            activate SUBMISSION_REPO

            SUBMISSION_REPO -> DB : SELECT assignment_submissions WHERE user_id = ? AND assignment_id = ?
            activate DB

            note right of DB
            DATABASE ACTION:
            READ assignment_submissions

            Purpose:
            - kiểm tra nộp trước đó

            Returned Fields:
            - submission_id
            - status
            end note

            DB --> SUBMISSION_REPO : existing / null
            deactivate DB
            SUBMISSION_REPO --> ASSIGNMENT_SERVICE : existing / null
            deactivate SUBMISSION_REPO

            ASSIGNMENT_SERVICE -> SUBMISSION_REPO : createOrUpdateSubmission(user_id, assignment_id, payload)
            activate SUBMISSION_REPO

            note right of SUBMISSION_REPO
            Repository Method:
            createOrUpdateSubmission(...)

            Input:
            - user_id
            - assignment_id
            - submission_content
            - submitted_at

            Output:
            - submission_entity
            end note

            SUBMISSION_REPO -> DB : INSERT INTO assignment_submissions OR UPDATE
            activate DB

            note right of DB
            DATABASE ACTION:
            WRITE assignment_submissions

            Purpose:
            - lưu bài nộp

            Insert/Update Fields:
            - submission_id
            - user_id
            - assignment_id
            - submission_content
            - file_urls
            - submitted_at
            - status = SUBMITTED
            end note

            DB --> SUBMISSION_REPO : submission_id
            deactivate DB
            SUBMISSION_REPO --> ASSIGNMENT_SERVICE : submission entity
            deactivate SUBMISSION_REPO

            ASSIGNMENT_SERVICE -> NOTIFY_SERVICE : notifyMentorOrSystem(assignment_id, submission_id)
            activate NOTIFY_SERVICE

            note right of NOTIFY_SERVICE
            Notification:
            - get mentor/reviewer
            - create notification
            - send email/SMS
            end note

            NOTIFY_SERVICE -> NOTIFICATION_REPO : createNotification(...)
            activate NOTIFICATION_REPO

            NOTIFICATION_REPO -> DB : INSERT INTO notifications
            activate DB

            note right of DB
            DATABASE ACTION:
            WRITE notifications

            Purpose:
            - tạo thông báo cho mentor

            Insert Fields:
            - notification_id
            - recipient_id
            - assignment_id
            - submission_id
            - type = NEW_SUBMISSION
            end note

            DB --> NOTIFICATION_REPO : success
            deactivate DB
            NOTIFICATION_REPO --> NOTIFY_SERVICE : success
            deactivate NOTIFICATION_REPO

            NOTIFY_SERVICE --> ASSIGNMENT_SERVICE : success
            deactivate NOTIFY_SERVICE

        end

        ASSIGNMENT_SERVICE --> ASSIGNMENT_CONTROLLER : SubmissionResponseDTO
        deactivate ASSIGNMENT_SERVICE

        note right of ASSIGNMENT_CONTROLLER
        Response DTO:
        {
          submission_id,
          assignment_id,
          status,
          submitted_at
        }
        end note

        ASSIGNMENT_CONTROLLER --> UI : 201 CREATED
        deactivate ASSIGNMENT_CONTROLLER
        UI --> LEARNER : Hiển thị nộp bài thành công
        deactivate UI
    end
end

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    ASSIGNMENT_SERVICE -> ASSIGNMENT_SERVICE : catch(SystemException)

    note right of ASSIGNMENT_SERVICE
    Rollback Conditions:
    - DB insert thất bại
    - assignment validation lỗi
    - notification service lỗi

    Action:
    - rollback transaction
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
