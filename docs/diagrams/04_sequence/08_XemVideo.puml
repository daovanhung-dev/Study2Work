@startuml
title STUDY2WORK - Sequence - Xem video
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Học viên" as LEARNER
boundary "Web/App UI" as UI

box "API Layer" #F9FBFD
control "LessonController" as LESSON_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "LessonService" as LESSON_SERVICE
control "ProgressService" as PROGRESS_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "LessonRepository" as LESSON_REPO
entity "ProgressRepository" as PROGRESS_REPO
entity "WatchLogRepository" as WATCHLOG_REPO
end box

box "External Services" #FFFDF7
control "CDN / Streaming Service" as CDN_SERVICE
end box

database "MySQL DB" as DB

== Phát video ==

LEARNER -> UI : Nhấn play video
activate UI

UI -> LESSON_CONTROLLER : GET /api/v1/lessons/{id}/video
activate LESSON_CONTROLLER

note right of LESSON_CONTROLLER
Expected Response:
200 OK
401 UNAUTHORIZED
403 FORBIDDEN
404 NOT_FOUND
500 INTERNAL_SERVER_ERROR
end note

LESSON_CONTROLLER -> LESSON_SERVICE : openVideo(user_id, lesson_id)
activate LESSON_SERVICE

LESSON_SERVICE -> LESSON_REPO : checkAccessAndLoad(lesson_id, user_id)
activate LESSON_REPO

note right of LESSON_REPO
Repository Method:
checkAccessAndLoad(lessonId, userId)

Input:
- lesson_id
- user_id

Output:
- LessonEntity + access status
end note

LESSON_REPO -> DB : SELECT course_lessons, course_enrollments WHERE lesson_id = ? AND user_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ course_lessons, course_enrollments

Purpose:
- kiểm tra quyền truy cập

Returned Fields:
- lesson_id
- course_id
- video_url
- duration
end note

DB --> LESSON_REPO : lesson + access
deactivate DB
LESSON_REPO --> LESSON_SERVICE : lesson + access
deactivate LESSON_REPO

alt Không có quyền
    LESSON_SERVICE --> LESSON_CONTROLLER : ForbiddenException
    LESSON_CONTROLLER --> UI : 403 FORBIDDEN
    UI --> LEARNER : Thông báo chưa được phép xem
else Có quyền

    group BEGIN TRANSACTION

        LESSON_SERVICE -> PROGRESS_SERVICE : getOrCreateProgress(user_id, lesson_id)
        activate PROGRESS_SERVICE

        PROGRESS_SERVICE -> PROGRESS_REPO : findOrCreateProgress(user_id, lesson_id)
        activate PROGRESS_REPO

        note right of PROGRESS_REPO
        Repository Method:
        findOrCreateProgress(userId, lessonId)

        Input:
        - user_id
        - lesson_id

        Output:
        - progress_entity
        end note

        PROGRESS_REPO -> DB : SELECT lesson_progress OR INSERT
        activate DB

        note right of DB
        DATABASE ACTION:
        READ/WRITE lesson_progress

        Purpose:
        - lấy hoặc tạo tiến độ

        Fields:
        - progress_id
        - user_id
        - lesson_id
        - watch_duration
        - status
        end note

        DB --> PROGRESS_REPO : progress
        deactivate DB
        PROGRESS_REPO --> PROGRESS_SERVICE : progress entity
        deactivate PROGRESS_REPO

        PROGRESS_SERVICE --> LESSON_SERVICE : progress
        deactivate PROGRESS_SERVICE

        LESSON_SERVICE -> WATCHLOG_REPO : createWatchLog(user_id, lesson_id, 0)
        activate WATCHLOG_REPO

        WATCHLOG_REPO -> DB : INSERT INTO video_watch_logs (user_id, lesson_id, position, timestamp)
        activate DB

        note right of DB
        DATABASE ACTION:
        WRITE video_watch_logs

        Purpose:
        - ghi lại thời gian bắt đầu xem

        Insert Fields:
        - watch_log_id
        - user_id
        - lesson_id
        - position = 0
        - timestamp
        end note

        DB --> WATCHLOG_REPO : success
        deactivate DB
        WATCHLOG_REPO --> LESSON_SERVICE : success
        deactivate WATCHLOG_REPO

    end

    LESSON_SERVICE -> CDN_SERVICE : getStreamingURL(video_url)
    activate CDN_SERVICE

    note right of CDN_SERVICE
    CDN Service:
    - tạo signed URL
    - xác định bitrate
    - prepare streaming
    end note

    CDN_SERVICE --> LESSON_SERVICE : streaming_url
    deactivate CDN_SERVICE

    LESSON_SERVICE --> LESSON_CONTROLLER : VideoStreamResponseDTO
    deactivate LESSON_SERVICE

    note right of LESSON_CONTROLLER
    Response DTO:
    {
      lesson_id,
      video_url,
      duration,
      progress_position
    }
    end note

    LESSON_CONTROLLER --> UI : 200 OK
    deactivate LESSON_CONTROLLER
    UI --> LEARNER : Phát video + lưu vị trí
    deactivate UI

    == Cập nhật tiến độ xem ==

    loop Trong lúc xem (tạm dừng/tua/tiếp tục)
        LEARNER -> UI : Tạm dừng / tua / tiếp tục
        activate UI
        UI -> LESSON_CONTROLLER : POST /api/v1/lessons/{id}/progress
        activate LESSON_CONTROLLER

        LESSON_CONTROLLER -> LESSON_SERVICE : updateProgress(lesson_id, position)
        activate LESSON_SERVICE

        group BEGIN TRANSACTION

            LESSON_SERVICE -> PROGRESS_REPO : updateLessonProgress(user_id, lesson_id, position)
            activate PROGRESS_REPO

            PROGRESS_REPO -> DB : UPDATE lesson_progress SET watch_duration = ?, updated_at = NOW()
            activate DB

            note right of DB
            DATABASE ACTION:
            WRITE lesson_progress

            Purpose:
            - cập nhật vị trí xem

            Updated Fields:
            - watch_duration
            - updated_at
            end note

            DB --> PROGRESS_REPO : success
            deactivate DB
            PROGRESS_REPO --> LESSON_SERVICE : success
            deactivate PROGRESS_REPO

            LESSON_SERVICE -> WATCHLOG_REPO : appendWatchLog(user_id, lesson_id, position)
            activate WATCHLOG_REPO

            WATCHLOG_REPO -> DB : INSERT INTO video_watch_logs (user_id, lesson_id, position, timestamp)
            activate DB

            note right of DB
            DATABASE ACTION:
            WRITE video_watch_logs

            Purpose:
            - ghi lại các điểm xem quan trọng

            Insert Fields:
            - watch_log_id
            - user_id
            - lesson_id
            - position
            - timestamp
            end note

            DB --> WATCHLOG_REPO : success
            deactivate DB
            WATCHLOG_REPO --> LESSON_SERVICE : success
            deactivate WATCHLOG_REPO

        end

        LESSON_SERVICE --> LESSON_CONTROLLER : OK
        deactivate LESSON_SERVICE
        LESSON_CONTROLLER --> UI : 200 OK
        deactivate LESSON_CONTROLLER
        deactivate UI
    end

end

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    LESSON_SERVICE -> LESSON_SERVICE : catch(SystemException)

    note right of LESSON_SERVICE
    Rollback Conditions:
    - DB update thất bại
    - CDN service lỗi
    - access check lỗi

    Action:
    - rollback transaction
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
