@startuml
title STUDY2WORK - Sequence - Kiểm tra đầu vào
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Học viên" as LEARNER
boundary "Web/App UI" as UI

box "API Layer" #F9FBFD
control "PlacementController" as PLACEMENT_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "PlacementService" as PLACEMENT_SERVICE
control "ScoringService" as SCORING_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "TestRepository" as TEST_REPO
entity "QuestionRepository" as QUESTION_REPO
entity "AttemptRepository" as ATTEMPT_REPO
entity "AnswerRepository" as ANSWER_REPO
end box

database "MySQL DB" as DB

== Bắt đầu test đầu vào ==

LEARNER -> UI : Nhấn bắt đầu test
activate UI

UI -> PLACEMENT_CONTROLLER : GET /api/v1/placement-test/{id}
activate PLACEMENT_CONTROLLER

note right of PLACEMENT_CONTROLLER
Expected Response:
200 OK
401 UNAUTHORIZED
403 FORBIDDEN
404 NOT_FOUND
500 INTERNAL_SERVER_ERROR
end note

PLACEMENT_CONTROLLER -> PLACEMENT_SERVICE : startTest(user_id, test_id)
activate PLACEMENT_SERVICE

PLACEMENT_SERVICE -> TEST_REPO : findTest(test_id)
activate TEST_REPO

note right of TEST_REPO
Repository Method:
findTest(testId)

Input:
- test_id

Output:
- TestEntity?
end note

TEST_REPO -> DB : SELECT * FROM placement_tests WHERE test_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ placement_tests

Purpose:
- tải thông tin test

Returned Fields:
- test_id
- test_name
- description
- total_questions
- status
- time_limit
end note

DB --> TEST_REPO : test record
deactivate DB
TEST_REPO --> PLACEMENT_SERVICE : test entity
deactivate TEST_REPO

PLACEMENT_SERVICE -> QUESTION_REPO : getQuestions(test_id)
activate QUESTION_REPO

note right of QUESTION_REPO
Repository Method:
getQuestions(testId)

Input:
- test_id

Output:
- QuestionEntity[]
end note

QUESTION_REPO -> DB : SELECT * FROM placement_questions WHERE test_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ placement_questions

Purpose:
- tải danh sách câu hỏi

Returned Fields:
- question_id
- test_id
- question_text
- question_type
- difficulty
end note

DB --> QUESTION_REPO : questions[]
deactivate DB
QUESTION_REPO --> PLACEMENT_SERVICE : questions[]
deactivate QUESTION_REPO

group BEGIN TRANSACTION

    PLACEMENT_SERVICE -> ATTEMPT_REPO : createAttempt(user_id, test_id)
    activate ATTEMPT_REPO

    note right of ATTEMPT_REPO
    Repository Method:
    createAttempt(userId, testId)

    Input:
    - user_id
    - test_id
    - started_at

    Output:
    - attempt_entity
    end note

    ATTEMPT_REPO -> DB : INSERT INTO placement_attempts (user_id, test_id, started_at, status)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE placement_attempts

    Purpose:
    - tạo bản ghi attempt mới

    Insert Fields:
    - attempt_id
    - user_id
    - test_id
    - started_at
    - status = IN_PROGRESS
    end note

    DB --> ATTEMPT_REPO : attempt_id
    deactivate DB
    ATTEMPT_REPO --> PLACEMENT_SERVICE : attempt entity
    deactivate ATTEMPT_REPO

end

PLACEMENT_SERVICE --> PLACEMENT_CONTROLLER : TestPackageDTO
deactivate PLACEMENT_SERVICE

note right of PLACEMENT_CONTROLLER
Response DTO:
{
  test_id,
  test_name,
  attempt_id,
  questions[],
  time_limit
}
end note

PLACEMENT_CONTROLLER --> UI : 200 OK
deactivate PLACEMENT_CONTROLLER
UI --> LEARNER : Hiển thị câu hỏi + đồng hồ
deactivate UI

== Làm bài test ==

loop Mỗi câu hỏi
    LEARNER -> UI : Chọn đáp án / nhập trả lời
    activate UI
    UI -> PLACEMENT_CONTROLLER : POST /api/v1/placement-test/{id}/answer
    activate PLACEMENT_CONTROLLER

    PLACEMENT_CONTROLLER -> PLACEMENT_SERVICE : saveAnswer(attempt_id, question_id, answer)
    activate PLACEMENT_SERVICE

    PLACEMENT_SERVICE -> ANSWER_REPO : upsertAttemptAnswer(attempt_id, question_id, answer)
    activate ANSWER_REPO

    note right of ANSWER_REPO
    Repository Method:
    upsertAttemptAnswer(...)

    Input:
    - attempt_id
    - question_id
    - answer_value
    end note

    ANSWER_REPO -> DB : INSERT INTO placement_attempt_answers OR UPDATE
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE placement_attempt_answers

    Purpose:
    - lưu câu trả lời

    Insert Fields:
    - attempt_id
    - question_id
    - answer_value
    - answered_at
    end note

    DB --> ANSWER_REPO : success
    deactivate DB
    ANSWER_REPO --> PLACEMENT_SERVICE : success
    deactivate ANSWER_REPO
    PLACEMENT_SERVICE --> PLACEMENT_CONTROLLER : OK
    deactivate PLACEMENT_SERVICE
    PLACEMENT_CONTROLLER --> UI : 200 OK
    deactivate PLACEMENT_CONTROLLER
    deactivate UI
end

== Nộp bài test ==

LEARNER -> UI : Nộp bài
activate UI
UI -> PLACEMENT_CONTROLLER : POST /api/v1/placement-test/{id}/submit
activate PLACEMENT_CONTROLLER

PLACEMENT_CONTROLLER -> PLACEMENT_SERVICE : submitAttempt(attempt_id)
activate PLACEMENT_SERVICE

group BEGIN TRANSACTION

    PLACEMENT_SERVICE -> ATTEMPT_REPO : finalizeAttempt(attempt_id)
    activate ATTEMPT_REPO

    ATTEMPT_REPO -> DB : UPDATE placement_attempts SET status = COMPLETED, finished_at = NOW()
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE placement_attempts

    Purpose:
    - đánh dấu hoàn thành

    Updated Fields:
    - status = COMPLETED
    - finished_at
    end note

    DB --> ATTEMPT_REPO : success
    deactivate DB
    ATTEMPT_REPO --> PLACEMENT_SERVICE : success
    deactivate ATTEMPT_REPO

    PLACEMENT_SERVICE -> SCORING_SERVICE : calculateScore(attempt_id)
    activate SCORING_SERVICE

    note right of SCORING_SERVICE
    Scoring Service:
    - tính điểm
    - xác định mức độ
    - gán roadmap gợi ý
    end note

    SCORING_SERVICE -> ANSWER_REPO : getAttemptAnswers(attempt_id)
    activate ANSWER_REPO
    ANSWER_REPO -> DB : SELECT placement_attempt_answers
    activate DB
    DB --> ANSWER_REPO : answers[]
    deactivate DB
    ANSWER_REPO --> SCORING_SERVICE : answers[]
    deactivate ANSWER_REPO

    SCORING_SERVICE --> PLACEMENT_SERVICE : score, level
    deactivate SCORING_SERVICE

    PLACEMENT_SERVICE -> ATTEMPT_REPO : updateScore(attempt_id, score, level)
    activate ATTEMPT_REPO

    ATTEMPT_REPO -> DB : UPDATE placement_attempts SET score = ?, level = ?, updated_at = NOW()
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE placement_attempts

    Updated Fields:
    - score
    - level
    - updated_at
    end note

    DB --> ATTEMPT_REPO : success
    deactivate DB
    ATTEMPT_REPO --> PLACEMENT_SERVICE : success
    deactivate ATTEMPT_REPO

end

PLACEMENT_SERVICE --> PLACEMENT_CONTROLLER : ResultResponseDTO
deactivate PLACEMENT_SERVICE

note right of PLACEMENT_CONTROLLER
Response DTO:
{
  attempt_id,
  score,
  level,
  passed,
  message
}
end note

PLACEMENT_CONTROLLER --> UI : 200 OK
deactivate PLACEMENT_CONTROLLER
UI --> LEARNER : Hiển thị điểm + mức đánh giá
deactivate UI

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    PLACEMENT_SERVICE -> PLACEMENT_SERVICE : catch(SystemException)

    note right of PLACEMENT_SERVICE
    Rollback Conditions:
    - DB insert/update thất bại
    - scoring logic lỗi
    - answer validation lỗi

    Action:
    - rollback transaction
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
