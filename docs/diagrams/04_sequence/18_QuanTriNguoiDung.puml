@startuml
title STUDY2WORK - Sequence - Quản trị người dùng
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Quản trị viên" as ADMIN
boundary "Admin UI" as UI

box "API Layer" #F9FBFD
control "AdminUserController" as ADMIN_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "AdminUserService" as ADMIN_SERVICE
control "AuditService" as AUDIT_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "UserRepository" as USER_REPO
entity "RoleRepository" as ROLE_REPO
entity "ProfileRepository" as PROFILE_REPO
entity "AuditLogRepository" as AUDIT_REPO
entity "NotificationRepository" as NOTIFICATION_REPO
end box

database "MySQL DB" as DB

== Xem quản lý người dùng ==

ADMIN -> UI : Mở quản lý người dùng
activate UI

UI -> ADMIN_CONTROLLER : GET /api/v1/admin/users
activate ADMIN_CONTROLLER

note right of ADMIN_CONTROLLER
Query Parameters:
- filter
- search
- status
- page
- limit

Expected Response:
200 OK
401 UNAUTHORIZED
403 FORBIDDEN
500 INTERNAL_SERVER_ERROR
end note

ADMIN_CONTROLLER -> ADMIN_SERVICE : listUsers(filters)
activate ADMIN_SERVICE

ADMIN_SERVICE -> USER_REPO : findUsers(filters)
activate USER_REPO

note right of USER_REPO
Repository Method:
findUsers(filters)

Input:
- filters object

Output:
- UserEntity[]
end note

USER_REPO -> DB : SELECT users WHERE filters MATCH ? ORDER BY created_at DESC LIMIT ?
activate DB

note right of DB
DATABASE ACTION:
READ users

Purpose:
- lấy danh sách người dùng

Returned Fields:
- user_id
- email
- phone
- status
- created_at
- last_login_at
end note

DB --> USER_REPO : users[]
deactivate DB
USER_REPO --> ADMIN_SERVICE : users[]
deactivate USER_REPO

ADMIN_SERVICE --> ADMIN_CONTROLLER : UsersListResponseDTO
deactivate ADMIN_SERVICE

ADMIN_CONTROLLER --> UI : 200 OK
deactivate ADMIN_CONTROLLER
UI --> ADMIN : Hiển thị danh sách
deactivate UI

== Cập nhật người dùng ==

ADMIN -> UI : Chọn khóa / đổi vai trò
activate UI

UI -> ADMIN_CONTROLLER : PUT /api/v1/admin/users/{id}
activate ADMIN_CONTROLLER

note right of ADMIN_CONTROLLER
Request DTO:
{
  user_id,
  status,
  roles[],
  action_type
}

Expected Response:
200 OK
401 UNAUTHORIZED
403 FORBIDDEN
404 NOT_FOUND
422 VALIDATION_ERROR
500 INTERNAL_SERVER_ERROR
end note

ADMIN_CONTROLLER -> ADMIN_SERVICE : updateUser(user_id, payload)
activate ADMIN_SERVICE

group BEGIN TRANSACTION

    ADMIN_SERVICE -> USER_REPO : updateStatus(user_id, status)
    activate USER_REPO

    note right of USER_REPO
    Repository Method:
    updateStatus(userId, status)

    Input:
    - user_id
    - status

    Output:
    - updated rows
    end note

    USER_REPO -> DB : UPDATE users SET status = ?, updated_at = NOW() WHERE user_id = ?
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE users

    Updated Fields:
    - status
    - updated_at

    Purpose:
    - cập nhật trạng thái người dùng
    end note

    DB --> USER_REPO : rows affected
    deactivate DB
    USER_REPO --> ADMIN_SERVICE : success
    deactivate USER_REPO

    ADMIN_SERVICE -> ROLE_REPO : updateRoles(user_id, role_ids)
    activate ROLE_REPO

    note right of ROLE_REPO
    Repository Method:
    updateRoles(userId, roleIds)

    Input:
    - user_id
    - role_ids[]

    Purpose:
    - cập nhật vai trò
    end note

    ROLE_REPO -> DB : DELETE user_roles WHERE user_id = ?
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE user_roles

    Purpose:
    - xóa vai trò cũ
    end note

    DB --> ROLE_REPO : success
    deactivate DB

    ROLE_REPO -> DB : INSERT INTO user_roles (user_id, role_id) VALUES (?, ?)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE user_roles

    Purpose:
    - thêm vai trò mới
    end note

    DB --> ROLE_REPO : success
    deactivate DB
    ROLE_REPO --> ADMIN_SERVICE : success
    deactivate ROLE_REPO

    ADMIN_SERVICE -> PROFILE_REPO : updateProfileIfNeeded(user_id)
    activate PROFILE_REPO

    PROFILE_REPO -> DB : UPDATE user_profiles SET updated_at = NOW() WHERE user_id = ?
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE user_profiles

    Updated Fields:
    - updated_at
    end note

    DB --> PROFILE_REPO : success
    deactivate DB
    PROFILE_REPO --> ADMIN_SERVICE : success
    deactivate PROFILE_REPO

    ADMIN_SERVICE -> AUDIT_SERVICE : writeAudit(admin_id, action, user_id)
    activate AUDIT_SERVICE

    AUDIT_SERVICE -> AUDIT_REPO : createAuditLog(...)
    activate AUDIT_REPO

    AUDIT_REPO -> DB : INSERT INTO admin_audit_logs (admin_id, action, target_user_id, changes, timestamp)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE admin_audit_logs

    Insert Fields:
    - audit_id
    - admin_id
    - action
    - target_user_id
    - changes
    - timestamp
    end note

    DB --> AUDIT_REPO : success
    deactivate DB
    AUDIT_REPO --> AUDIT_SERVICE : success
    deactivate AUDIT_REPO

    AUDIT_SERVICE --> ADMIN_SERVICE : success
    deactivate AUDIT_SERVICE

    ADMIN_SERVICE -> NOTIFICATION_REPO : createNotification(user_id, notification_type)
    activate NOTIFICATION_REPO

    NOTIFICATION_REPO -> DB : INSERT INTO notifications (recipient_id, type, message, created_at)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE notifications

    Insert Fields:
    - notification_id
    - recipient_id
    - type = ACCOUNT_STATUS_CHANGED
    - message
    end note

    DB --> NOTIFICATION_REPO : success
    deactivate DB
    NOTIFICATION_REPO --> ADMIN_SERVICE : success
    deactivate NOTIFICATION_REPO

end

ADMIN_SERVICE --> ADMIN_CONTROLLER : UpdateUserResponseDTO
deactivate ADMIN_SERVICE

ADMIN_CONTROLLER --> UI : 200 OK
deactivate ADMIN_CONTROLLER
UI --> ADMIN : Thông báo cập nhật thành công
deactivate UI

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    ADMIN_SERVICE -> ADMIN_SERVICE : catch(SystemException)

    note right of ADMIN_SERVICE
    Rollback Conditions:
    - DB update thất bại
    - role assignment lỗi
    - audit log thất bại

    Action:
    - rollback transaction
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
