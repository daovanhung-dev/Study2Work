@startuml
title STUDY2WORK - Sequence - Làm quiz
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Học viên" as LEARNER
boundary "Web/App UI" as UI

box "API Layer" #F9FBFD
control "QuizController" as QUIZ_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "QuizService" as QUIZ_SERVICE
control "ScoringService" as SCORING_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "QuizRepository" as QUIZ_REPO
entity "QuestionRepository" as QUESTION_REPO
entity "OptionRepository" as OPTION_REPO
entity "AttemptRepository" as ATTEMPT_REPO
entity "AnswerRepository" as ANSWER_REPO
end box

database "MySQL DB" as DB

== Bắt đầu quiz ==

LEARNER -> UI : Mở quiz
activate UI

UI -> QUIZ_CONTROLLER : GET /api/v1/quizzes/{id}
activate QUIZ_CONTROLLER

QUIZ_CONTROLLER -> QUIZ_SERVICE : startQuiz(user_id, quiz_id)
activate QUIZ_SERVICE

QUIZ_SERVICE -> QUIZ_REPO : getQuiz(quiz_id)
activate QUIZ_REPO

QUIZ_REPO -> DB : SELECT quizzes WHERE quiz_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ quizzes

Returned Fields:
- quiz_id
- quiz_name
- description
- total_questions
- time_limit
end note

DB --> QUIZ_REPO : quiz
deactivate DB
QUIZ_REPO --> QUIZ_SERVICE : quiz entity
deactivate QUIZ_REPO

QUIZ_SERVICE -> QUESTION_REPO : getQuestions(quiz_id)
activate QUESTION_REPO

QUESTION_REPO -> DB : SELECT quiz_questions WHERE quiz_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ quiz_questions

Returned Fields:
- question_id
- quiz_id
- question_text
- question_type
- order
end note

DB --> QUESTION_REPO : questions[]
deactivate DB
QUESTION_REPO --> QUIZ_SERVICE : questions[]
deactivate QUESTION_REPO

QUIZ_SERVICE -> OPTION_REPO : getOptions(question_ids)
activate OPTION_REPO

OPTION_REPO -> DB : SELECT quiz_options WHERE question_id IN (?)
activate DB

note right of DB
DATABASE ACTION:
READ quiz_options

Returned Fields:
- option_id
- question_id
- option_text
- is_correct
end note

DB --> OPTION_REPO : options[]
deactivate DB
OPTION_REPO --> QUIZ_SERVICE : options[]
deactivate OPTION_REPO

group BEGIN TRANSACTION

    QUIZ_SERVICE -> ATTEMPT_REPO : createAttempt(user_id, quiz_id)
    activate ATTEMPT_REPO

    ATTEMPT_REPO -> DB : INSERT INTO quiz_attempts (user_id, quiz_id, started_at, status)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE quiz_attempts

    Insert Fields:
    - attempt_id
    - user_id
    - quiz_id
    - started_at
    - status = IN_PROGRESS
    end note

    DB --> ATTEMPT_REPO : attempt_id
    deactivate DB
    ATTEMPT_REPO --> QUIZ_SERVICE : attempt entity
    deactivate ATTEMPT_REPO

end

QUIZ_SERVICE --> QUIZ_CONTROLLER : QuizPackageDTO
deactivate QUIZ_SERVICE

QUIZ_CONTROLLER --> UI : 200 OK
deactivate QUIZ_CONTROLLER
UI --> LEARNER : Hiển thị quiz
deactivate UI

== Trả lời quiz ==

loop Trả lời từng câu
    LEARNER -> UI : Chọn đáp án
    activate UI
    UI -> QUIZ_CONTROLLER : POST /api/v1/quizzes/{id}/answer
    activate QUIZ_CONTROLLER

    QUIZ_CONTROLLER -> QUIZ_SERVICE : saveAnswer(attempt_id, question_id, answer)
    activate QUIZ_SERVICE

    QUIZ_SERVICE -> ANSWER_REPO : upsertAnswer(attempt_id, question_id, answer)
    activate ANSWER_REPO

    ANSWER_REPO -> DB : INSERT INTO quiz_answers OR UPDATE
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE quiz_answers

    Insert Fields:
    - attempt_id
    - question_id
    - answer_value
    - answered_at
    end note

    DB --> ANSWER_REPO : success
    deactivate DB
    ANSWER_REPO --> QUIZ_SERVICE : success
    deactivate ANSWER_REPO

    QUIZ_SERVICE --> QUIZ_CONTROLLER : OK
    deactivate QUIZ_SERVICE
    QUIZ_CONTROLLER --> UI : 200 OK
    deactivate QUIZ_CONTROLLER
    deactivate UI
end

== Nộp quiz ==

LEARNER -> UI : Nộp quiz
activate UI
UI -> QUIZ_CONTROLLER : POST /api/v1/quizzes/{id}/submit
activate QUIZ_CONTROLLER

QUIZ_CONTROLLER -> QUIZ_SERVICE : submitQuiz(attempt_id)
activate QUIZ_SERVICE

group BEGIN TRANSACTION

    QUIZ_SERVICE -> ATTEMPT_REPO : finalizeAttempt(attempt_id)
    activate ATTEMPT_REPO

    ATTEMPT_REPO -> DB : UPDATE quiz_attempts SET status = COMPLETED, finished_at = NOW()
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE quiz_attempts

    Updated Fields:
    - status = COMPLETED
    - finished_at
    end note

    DB --> ATTEMPT_REPO : success
    deactivate DB
    ATTEMPT_REPO --> QUIZ_SERVICE : success
    deactivate ATTEMPT_REPO

    QUIZ_SERVICE -> SCORING_SERVICE : calculateScore(attempt_id)
    activate SCORING_SERVICE

    SCORING_SERVICE -> ANSWER_REPO : getAttemptAnswers(attempt_id)
    activate ANSWER_REPO
    ANSWER_REPO -> DB : SELECT quiz_answers
    activate DB
    DB --> ANSWER_REPO : answers[]
    deactivate DB
    ANSWER_REPO --> SCORING_SERVICE : answers[]
    deactivate ANSWER_REPO

    SCORING_SERVICE --> QUIZ_SERVICE : score, passed
    deactivate SCORING_SERVICE

    QUIZ_SERVICE -> ATTEMPT_REPO : updateScore(attempt_id, score)
    activate ATTEMPT_REPO

    ATTEMPT_REPO -> DB : UPDATE quiz_attempts SET score = ?, passed = ?, updated_at = NOW()
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE quiz_attempts

    Updated Fields:
    - score
    - passed
    - updated_at
    end note

    DB --> ATTEMPT_REPO : success
    deactivate DB
    ATTEMPT_REPO --> QUIZ_SERVICE : success
    deactivate ATTEMPT_REPO

end

QUIZ_SERVICE --> QUIZ_CONTROLLER : ResultResponseDTO
deactivate QUIZ_SERVICE

QUIZ_CONTROLLER --> UI : 200 OK
deactivate QUIZ_CONTROLLER
UI --> LEARNER : Hiển thị điểm
deactivate UI

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    QUIZ_SERVICE -> QUIZ_SERVICE : catch(SystemException)

    note right of QUIZ_SERVICE
    Rollback Conditions:
    - DB insert/update thất bại
    - scoring logic lỗi
    - answer validation lỗi

    Action:
    - rollback transaction
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
