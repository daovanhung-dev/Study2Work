@startuml
title STUDY2WORK - Sequence - Tải tài liệu
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Học viên" as LEARNER
boundary "Web/App UI" as UI

box "API Layer" #F9FBFD
control "ResourceController" as RESOURCE_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "DocumentService" as DOCUMENT_SERVICE
control "AccessService" as ACCESS_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "ResourceRepository" as RESOURCE_REPO
entity "LessonRepository" as LESSON_REPO
end box

box "External Services" #FFFDF7
control "Storage Service (S3)" as STORAGE_SERVICE
end box

database "MySQL DB" as DB

== Yêu cầu tải tài liệu ==

LEARNER -> UI : Chọn tài liệu để tải
activate UI

UI -> RESOURCE_CONTROLLER : GET /api/v1/resources/{id}/download
activate RESOURCE_CONTROLLER

note right of RESOURCE_CONTROLLER
Expected Response:
200 OK
301 REDIRECT
401 UNAUTHORIZED
403 FORBIDDEN
404 NOT_FOUND
500 INTERNAL_SERVER_ERROR
end note

RESOURCE_CONTROLLER -> DOCUMENT_SERVICE : getDownloadLink(user_id, resource_id)
activate DOCUMENT_SERVICE

DOCUMENT_SERVICE -> RESOURCE_REPO : findResource(resource_id)
activate RESOURCE_REPO

note right of RESOURCE_REPO
Repository Method:
findResource(resourceId)

Input:
- resource_id

Output:
- ResourceEntity?
end note

RESOURCE_REPO -> DB : SELECT lesson_resources WHERE resource_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ lesson_resources

Purpose:
- tải thông tin tài liệu

Returned Fields:
- resource_id
- lesson_id
- resource_name
- file_url
- file_type
- file_size
end note

DB --> RESOURCE_REPO : resource
deactivate DB
RESOURCE_REPO --> DOCUMENT_SERVICE : resource entity
deactivate RESOURCE_REPO

alt Không tìm thấy tài liệu
    DOCUMENT_SERVICE --> RESOURCE_CONTROLLER : NotFoundException(RESOURCE_NOT_FOUND)
    RESOURCE_CONTROLLER --> UI : 404 NOT_FOUND
    UI --> LEARNER : Hiển thị "Tài liệu không tồn tại"
else Tìm thấy tài liệu

    DOCUMENT_SERVICE -> ACCESS_SERVICE : checkLessonAccess(resource.lesson_id, user_id)
    activate ACCESS_SERVICE

    ACCESS_SERVICE -> LESSON_REPO : verifyEnrollment(lesson_id, user_id)
    activate LESSON_REPO

    note right of LESSON_REPO
    Repository Method:
    verifyEnrollment(lessonId, userId)

    Input:
    - lesson_id
    - user_id

    Output:
    - access_granted: boolean
    end note

    LESSON_REPO -> DB : SELECT course_lessons, course_enrollments WHERE lesson_id = ? AND user_id = ?
    activate DB

    note right of DB
    DATABASE ACTION:
    READ course_lessons, course_enrollments

    Purpose:
    - kiểm tra quyền truy cập

    Returned Fields:
    - course_id
    - enrollment_status
    end note

    DB --> LESSON_REPO : enrollment / null
    deactivate DB
    LESSON_REPO --> ACCESS_SERVICE : access status
    deactivate LESSON_REPO

    ACCESS_SERVICE --> DOCUMENT_SERVICE : access result
    deactivate ACCESS_SERVICE

    alt Không có quyền truy cập
        DOCUMENT_SERVICE --> RESOURCE_CONTROLLER : ForbiddenException(NO_ACCESS)
        RESOURCE_CONTROLLER --> UI : 403 FORBIDDEN
        UI --> LEARNER : Thông báo "Không được tải"
    else Có quyền truy cập

        DOCUMENT_SERVICE -> STORAGE_SERVICE : generateSignedURL(resource.file_url)
        activate STORAGE_SERVICE

        note right of STORAGE_SERVICE
        Storage Service (S3):
        - tạo signed URL
        - expire time: 1 hour
        - access control
        end note

        STORAGE_SERVICE --> DOCUMENT_SERVICE : signed_url
        deactivate STORAGE_SERVICE

        DOCUMENT_SERVICE --> RESOURCE_CONTROLLER : DownloadResponseDTO
        deactivate DOCUMENT_SERVICE

        note right of RESOURCE_CONTROLLER
        Response DTO:
        {
          resource_id,
          resource_name,
          download_url,
          file_size,
          content_type
        }
        end note

        RESOURCE_CONTROLLER --> UI : 200 OK / 301 REDIRECT
        deactivate RESOURCE_CONTROLLER
        UI --> LEARNER : Bắt đầu tải file
        deactivate UI

    end
end

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    DOCUMENT_SERVICE -> DOCUMENT_SERVICE : catch(SystemException)

    note right of DOCUMENT_SERVICE
    Rollback Conditions:
    - DB query thất bại
    - storage service lỗi
    - access verification lỗi

    Action:
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
