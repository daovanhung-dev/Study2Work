@startuml
title STUDY2WORK - Sequence - Thanh toán khóa học
autonumber
hide footbox
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam responseMessageBelowArrow true

skinparam sequence {
  LifeLineBorderColor #666666
  LifeLineBackgroundColor #F8F8F8
  ParticipantBorderColor #666666
  ParticipantBackgroundColor #FFFFFF
  ActorBorderColor #666666
  ActorBackgroundColor #FFFFFF
  BoxBorderColor #999999
  BoxBackgroundColor #FCFCFC
  NoteBackgroundColor #FFF9D9
  NoteBorderColor #B8A24A
  DatabaseBorderColor #6D6D6D
  DatabaseBackgroundColor #F8FBFF
  ControlBorderColor #4F6B8A
  ControlBackgroundColor #EEF5FC
}

actor "Học viên" as LEARNER
boundary "Web/App UI" as UI

box "API Layer" #F9FBFD
control "PaymentController" as PAYMENT_CONTROLLER
end box

box "Application Layer" #EEF6FF
control "OrderService" as ORDER_SERVICE
control "PaymentService" as PAYMENT_SERVICE
control "EnrollmentService" as ENROLLMENT_SERVICE
end box

box "Repository Layer" #F4FBF4
entity "CourseRepository" as COURSE_REPO
entity "CouponRepository" as COUPON_REPO
entity "OrderRepository" as ORDER_REPO
entity "PaymentRepository" as PAYMENT_REPO
entity "EnrollmentRepository" as ENROLLMENT_REPO
end box

box "External Services" #FFFDF7
control "Payment Gateway" as PAYMENT_GATEWAY
end box

database "MySQL DB" as DB

== Checkout khóa học ==

LEARNER -> UI : Chọn mua khóa học
activate UI

UI -> PAYMENT_CONTROLLER : POST /api/v1/checkout
activate PAYMENT_CONTROLLER

note right of PAYMENT_CONTROLLER
Request DTO:
{
  course_id,
  coupon_code
}

Expected Response:
200 OK / 201 CREATED
401 UNAUTHORIZED
403 FORBIDDEN
404 NOT_FOUND
422 VALIDATION_ERROR
500 INTERNAL_SERVER_ERROR
end note

PAYMENT_CONTROLLER -> ORDER_SERVICE : createOrder(user_id, course_id, coupon_code)
activate ORDER_SERVICE

ORDER_SERVICE -> COURSE_REPO : getCoursePrice(course_id)
activate COURSE_REPO

COURSE_REPO -> DB : SELECT courses WHERE course_id = ?
activate DB

note right of DB
DATABASE ACTION:
READ courses

Returned Fields:
- course_id
- price
- discount_percentage
- status
end note

DB --> COURSE_REPO : course
deactivate DB
COURSE_REPO --> ORDER_SERVICE : price
deactivate COURSE_REPO

opt Có mã giảm giá
    ORDER_SERVICE -> COUPON_REPO : validateCoupon(coupon_code)
    activate COUPON_REPO

    COUPON_REPO -> DB : SELECT coupons WHERE code = ? AND is_active = TRUE
    activate DB

    note right of DB
    DATABASE ACTION:
    READ coupons

    Returned Fields:
    - coupon_id
    - discount_percent
    - expiry_date
    end note

    DB --> COUPON_REPO : coupon
    deactivate DB
    COUPON_REPO --> ORDER_SERVICE : coupon / null
    deactivate COUPON_REPO
end

group BEGIN TRANSACTION

    ORDER_SERVICE -> ORDER_REPO : createOrder(user_id, course_id, coupon_code)
    activate ORDER_REPO

    ORDER_REPO -> DB : INSERT INTO orders (user_id, course_id, total_amount, discount, final_amount, status)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE orders

    Insert Fields:
    - order_id
    - user_id
    - course_id
    - total_amount
    - discount
    - final_amount
    - status = PENDING
    end note

    DB --> ORDER_REPO : order_id
    deactivate DB

    ORDER_REPO -> DB : INSERT INTO order_items (order_id, course_id, unit_price, quantity)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE order_items

    Insert Fields:
    - order_item_id
    - order_id
    - course_id
    - unit_price
    - quantity = 1
    end note

    DB --> ORDER_REPO : success
    deactivate DB
    ORDER_REPO --> ORDER_SERVICE : order entity
    deactivate ORDER_REPO

end

ORDER_SERVICE --> PAYMENT_CONTROLLER : OrderResponseDTO
deactivate ORDER_SERVICE

PAYMENT_CONTROLLER --> UI : 201 CREATED
deactivate PAYMENT_CONTROLLER
UI --> LEARNER : Chuyển sang thanh toán
deactivate UI

== Xử lý thanh toán ==

LEARNER -> UI : Nhập thông tin thanh toán
activate UI

UI -> PAYMENT_CONTROLLER : POST /api/v1/payments
activate PAYMENT_CONTROLLER

PAYMENT_CONTROLLER -> PAYMENT_SERVICE : processPayment(order_id, payment_data)
activate PAYMENT_SERVICE

PAYMENT_SERVICE -> PAYMENT_GATEWAY : pay(order_id, final_amount, payment_data)
activate PAYMENT_GATEWAY

note right of PAYMENT_GATEWAY
Payment Gateway:
- Stripe / Paypal
- process transaction
- validate card
- authorize payment
end note

PAYMENT_GATEWAY --> PAYMENT_SERVICE : payment result
deactivate PAYMENT_GATEWAY

alt Thanh toán thành công

    group BEGIN TRANSACTION

        PAYMENT_SERVICE -> PAYMENT_REPO : createPayment(order_id, success, transaction_id)
        activate PAYMENT_REPO

        PAYMENT_REPO -> DB : INSERT INTO payments (order_id, amount, status, transaction_id, created_at)
        activate DB

        note right of DB
        DATABASE ACTION:
        WRITE payments

        Insert Fields:
        - payment_id
        - order_id
        - amount
        - status = SUCCESS
        - transaction_id
        end note

        DB --> PAYMENT_REPO : success
        deactivate DB
        PAYMENT_REPO --> PAYMENT_SERVICE : payment entity
        deactivate PAYMENT_REPO

        PAYMENT_SERVICE -> ORDER_REPO : markPaid(order_id)
        activate ORDER_REPO

        ORDER_REPO -> DB : UPDATE orders SET status = PAID, updated_at = NOW()
        activate DB

        note right of DB
        DATABASE ACTION:
        WRITE orders

        Updated Fields:
        - status = PAID
        - updated_at
        end note

        DB --> ORDER_REPO : success
        deactivate DB
        ORDER_REPO --> PAYMENT_SERVICE : success
        deactivate ORDER_REPO

        PAYMENT_SERVICE -> ENROLLMENT_SERVICE : createEnrollment(user_id, course_id, order_id)
        activate ENROLLMENT_SERVICE

        ENROLLMENT_SERVICE -> ENROLLMENT_REPO : createEnrollment(user_id, course_id, order_id)
        activate ENROLLMENT_REPO

        ENROLLMENT_REPO -> DB : INSERT INTO course_enrollments (user_id, course_id, order_id, status)
        activate DB

        note right of DB
        DATABASE ACTION:
        WRITE course_enrollments

        Insert Fields:
        - enrollment_id
        - user_id
        - course_id
        - order_id
        - status = ACTIVE
        end note

        DB --> ENROLLMENT_REPO : enrollment_id
        deactivate DB
        ENROLLMENT_REPO --> ENROLLMENT_SERVICE : enrollment entity
        deactivate ENROLLMENT_REPO

        ENROLLMENT_SERVICE --> PAYMENT_SERVICE : success
        deactivate ENROLLMENT_SERVICE

    end

    PAYMENT_SERVICE --> PAYMENT_CONTROLLER : PaymentSuccessResponseDTO
    deactivate PAYMENT_SERVICE

    note right of PAYMENT_CONTROLLER
    Response DTO:
    {
      payment_id,
      order_id,
      status,
      enrollment_id
    }
    end note

    PAYMENT_CONTROLLER --> UI : 200 OK
    deactivate PAYMENT_CONTROLLER
    UI --> LEARNER : Mở quyền học
    deactivate UI

else Thanh toán thất bại

    PAYMENT_SERVICE -> PAYMENT_REPO : createPayment(order_id, failed, error_code)
    activate PAYMENT_REPO

    PAYMENT_REPO -> DB : INSERT INTO payments (order_id, amount, status, error_message, created_at)
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE payments

    Insert Fields:
    - payment_id
    - order_id
    - amount
    - status = FAILED
    - error_message
    end note

    DB --> PAYMENT_REPO : success
    deactivate DB
    PAYMENT_REPO --> PAYMENT_SERVICE : payment entity
    deactivate PAYMENT_REPO

    PAYMENT_SERVICE -> ORDER_REPO : markFailed(order_id)
    activate ORDER_REPO

    ORDER_REPO -> DB : UPDATE orders SET status = FAILED, updated_at = NOW()
    activate DB

    note right of DB
    DATABASE ACTION:
    WRITE orders

    Updated Fields:
    - status = FAILED
    - updated_at
    end note

    DB --> ORDER_REPO : success
    deactivate DB
    ORDER_REPO --> PAYMENT_SERVICE : success
    deactivate ORDER_REPO

    PAYMENT_SERVICE --> PAYMENT_CONTROLLER : PaymentFailureResponseDTO
    deactivate PAYMENT_SERVICE

    PAYMENT_CONTROLLER --> UI : 402 PAYMENT_REQUIRED
    deactivate PAYMENT_CONTROLLER
    UI --> LEARNER : Hiển thị lỗi thanh toán
    deactivate UI

end

== ERROR FLOW ==

group SYSTEM EXCEPTION FLOW
    PAYMENT_SERVICE -> PAYMENT_SERVICE : catch(SystemException)

    note right of PAYMENT_SERVICE
    Rollback Conditions:
    - payment gateway lỗi
    - DB insert/update thất bại
    - order validation lỗi

    Action:
    - rollback transaction
    - ghi log audit
    - cảnh báo monitoring
    end note
end

@enduml
