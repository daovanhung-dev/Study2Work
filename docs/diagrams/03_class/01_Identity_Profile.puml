@startuml Study2Work_Identity_Profile_Class
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

title Study2Work - Class - Identity & Profile
class User {
  +id: UUID
  +email: String
  +phone: String
  -passwordHash: String
  +status: UserStatus
  +lastLoginAt: DateTime
  +activate(): void
  +suspend(reason: String): void
  +deleteSoft(): void
  +canAuthenticate(): Boolean
}
class Credential {
  -passwordHash: String
  +verifyPassword(raw: String): Boolean
  +rotatePasswordHash(hash: String): void
}
class Session {
  +id: UUID
  +userId: UUID
  +expiresAt: DateTime
  +revokedAt: DateTime
  +revoke(): void
  +isActive(now: DateTime): Boolean
}
class RefreshToken {
  +id: UUID
  -tokenHash: String
  +expiresAt: DateTime
  +revokedAt: DateTime
  +rotate(newHash: String): void
  +revoke(): void
}
class VerificationToken {
  +id: UUID
  -tokenHash: String
  +expiresAt: DateTime
  +consume(now: DateTime): void
}
class Role {
  +id: UUID
  +code: String
  +name: String
  +addPermission(permission: Permission): void
}
class Permission {
  +id: UUID
  +code: String
  +description: String
}
class UserRole {
  +userId: UUID
  +roleId: UUID
  +assignedAt: DateTime
}
class Profile {
  +id: UUID
  +userId: UUID
  +displayName: String
  +avatarFileId: UUID
  +visibility: Visibility
  +update(data: ProfileData): void
}
class StudentProfile {
  +userId: UUID
  +learningGoal: String
  +status: ProfileStatus
  +updateGoal(goal: String): void
}
class MentorProfile {
  +userId: UUID
  +expertise: String
  +availability: String
  +assignScope(scope: Scope): void
}
class Skill {
  +id: UUID
  +skillCode: String
  +name: String
  +category: String
}
class UserSkill {
  +userId: UUID
  +skillId: UUID
  +currentLevel: SkillLevel
  +sourceUpdatedAt: DateTime
  +updateProjection(level: SkillLevel): void
}
User "1" *-- "1" Credential
User "1" -- "0..*" Session
User "1" -- "0..*" RefreshToken
User "1" -- "0..*" VerificationToken
User "1" -- "0..*" UserRole
Role "1" -- "0..*" UserRole
Role "1" -- "0..*" Permission
User "1" -- "1" Profile
User "1" -- "0..1" StudentProfile
User "1" -- "0..1" MentorProfile
User "1" -- "0..*" UserSkill
Skill "1" -- "0..*" UserSkill
@enduml
