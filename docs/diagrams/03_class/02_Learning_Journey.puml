@startuml Study2Work_Learning_Class
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

title Study2Work - Class - Learning Journey
class LearningPath {
  +id: UUID
  +code: String
  +title: String
  +level: String
  +status: ContentStatus
  +publish(): void
  +canEnroll(): Boolean
}
class LearningPathStage {
  +id: UUID
  +pathId: UUID
  +orderNo: Integer
  +title: String
  +moveTo(orderNo: Integer): void
}
class LearningModule {
  +id: UUID
  +pathId: UUID
  +stageId: UUID
  +code: String
  +orderNo: Integer
  +status: ContentStatus
  +publish(): void
}
class Lesson {
  +id: UUID
  +moduleId: UUID
  +type: LessonType
  +unlockRule: Json
  +status: ContentStatus
  +isUnlockedFor(userId: UUID): Boolean
}
class LessonContent {
  +id: UUID
  +lessonId: UUID
  +contentType: ContentType
  +uri: String
  +fileId: UUID
  +isServable(): Boolean
}
class LiveSession {
  +id: UUID
  +lessonId: UUID
  +mentorId: UUID
  +startsAt: DateTime
  +capacity: Integer
  +canJoin(userId: UUID): Boolean
}
class LearningPathEnrollment {
  +id: UUID
  +userId: UUID
  +pathId: UUID
  +enrollmentStatus: EnrollmentStatus
  +start(): void
  +complete(): void
  +drop(reason: String): void
}
class LearningProgress {
  +id: UUID
  +userId: UUID
  +lessonId: UUID
  +progressStatus: ProgressStatus
  +lastPosition: Integer
  +start(): void
  +recordPosition(position: Integer): void
  +completeByRule(): void
}
class Bookmark {
  +id: UUID
  +userId: UUID
  +lessonId: UUID
  +note: String
  +toggle(): void
}
class LessonComment {
  +id: UUID
  +userId: UUID
  +lessonId: UUID
  +content: String
  +status: ModerationStatus
  +approve(): void
  +reject(reason: String): void
}
LearningPath "1" *-- "1..*" LearningPathStage
LearningPath "1" *-- "1..*" LearningModule
LearningModule "1" *-- "1..*" Lesson
Lesson "1" *-- "1..*" LessonContent
Lesson "0..1" -- "0..*" LiveSession
LearningPath "1" -- "0..*" LearningPathEnrollment
Lesson "1" -- "0..*" LearningProgress
Lesson "1" -- "0..*" Bookmark
Lesson "1" -- "0..*" LessonComment
@enduml
