@startuml Study2Work_AI_Class
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

title Study2Work - Class - AI Learning Support
class AIConversation {
  +id: UUID
  +userId: UUID
  +context: Json
  +open(): void
  +close(): void
}
class AIRequest {
  +id: UUID
  +conversationId: UUID
  +type: AIRequestType
  +inputSnapshot: Json
  +status: AIRequestStatus
  +traceId: UUID
  +redactSensitiveInput(): void
  +markCompleted(): void
  +markFailed(reason: String): void
}
class AIInsight {
  +id: UUID
  +requestId: UUID
  +output: Json
  +confidence: Decimal
  +createdAt: DateTime
  +isAuthoritative(): Boolean
}
class RoadmapSuggestion {
  +id: UUID
  +requestId: UUID
  +pathProposal: Json
  +explainReason(): String
}
class CodeExplanationRequest {
  +id: UUID
  +requestId: UUID
  +codeSnapshot: Json
  +language: String
  +explain(): String
}
class ReviewReport {
  +id: UUID
  +requestId: UUID
  +structuredReport: Json
  +markForHumanReview(): void
}
class RateLimitPolicy {
  +scope: String
  +limit: Integer
  +windowSeconds: Integer
  +check(userId: UUID): Boolean
}
AIConversation "1" *-- "0..*" AIRequest
AIRequest "1" *-- "0..*" AIInsight
AIRequest "1" -- "0..1" RoadmapSuggestion
AIRequest "1" -- "0..1" CodeExplanationRequest
AIRequest "1" -- "0..1" ReviewReport
AIRequest ..> RateLimitPolicy : checks
note right of AIInsight
AI output is recommendation only.
It never mutates score, progress, skill level or review truth.
Rules: BR-AI-001, BR-AI-002.
end note
@enduml
