@startuml Study2Work_Project_Class
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

title Study2Work - Class - Project & Teamwork
class Project {
  +id: UUID
  +moduleId: UUID
  +title: String
  +status: ProjectStatus
  +activate(): void
  +hold(reason: String): void
  +archive(): void
}
class Team {
  +id: UUID
  +projectId: UUID
  +name: String
  +createMember(userId: UUID, role: TeamRole): TeamMember
}
class TeamMember {
  +id: UUID
  +teamId: UUID
  +userId: UUID
  +teamRole: TeamRole
  +changeRole(role: TeamRole): void
}
class Sprint {
  +id: UUID
  +projectId: UUID
  +name: String
  +startsAt: DateTime
  +endsAt: DateTime
  +status: SprintStatus
  +activate(): void
  +close(): void
}
class Task {
  +id: UUID
  +projectId: UUID
  +sprintId: UUID
  +assigneeId: UUID
  +status: TaskStatus
  +priority: Priority
  +transitionTo(status: TaskStatus, reason: String): void
}
class TaskComment {
  +id: UUID
  +taskId: UUID
  +userId: UUID
  +body: String
  +edit(body: String): void
}
class TaskAttachment {
  +id: UUID
  +taskId: UUID
  +fileId: UUID
  +scanStatus: ScanStatus
}
class WorkLog {
  +id: UUID
  +taskId: UUID
  +userId: UUID
  +durationMinutes: Integer
  +workDate: Date
  +record(): void
}
class GitRepositoryLink {
  +id: UUID
  +projectId: UUID
  +provider: String
  +repoUrl: String
  +externalId: String
  +verifyWebhookSignature(): Boolean
}
class PullRequestReview {
  +id: UUID
  +taskId: UUID
  +reviewerId: UUID
  +externalPrId: String
  +status: ReviewStatus
  +recordEvidence(): void
}
class ProjectMilestone {
  +id: UUID
  +projectId: UUID
  +title: String
  +dueAt: DateTime
  +status: MilestoneStatus
}
class ProjectSubmission {
  +id: UUID
  +projectId: UUID
  +teamId: UUID
  +version: Integer
  +status: SubmissionStatus
  +artifactFileId: UUID
  +submitVersion(): void
}
Project "1" *-- "0..*" Team
Team "1" *-- "1..*" TeamMember
Project "1" *-- "0..*" Sprint
Project "1" *-- "0..*" Task
Sprint "1" -- "0..*" Task
Task "1" *-- "0..*" TaskComment
Task "1" *-- "0..*" TaskAttachment
Task "1" *-- "0..*" WorkLog
Project "1" -- "0..*" GitRepositoryLink
Task "1" -- "0..*" PullRequestReview
Project "1" -- "0..*" ProjectMilestone
Project "1" -- "0..*" ProjectSubmission
Team "1" -- "0..*" ProjectSubmission
@enduml
