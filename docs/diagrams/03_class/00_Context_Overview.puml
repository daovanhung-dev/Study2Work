@startuml Study2Work_Context_Class_Overview
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

title Study2Work - Class Overview - Bounded Contexts
package "Identity & Profile" {
  class User {
    +id: UUID
    +email: String
    +status: UserStatus
    +activate(): void
    +suspend(reason: String): void
  }
  class Profile {
    +id: UUID
    +displayName: String
    +visibility: Visibility
    +updateDisplayName(value: String): void
  }
}
package "Learning Journey" {
  class LearningPath {
  +id: UUID
  +code: String
  +publish(): void
}
  class Lesson {
  +id: UUID
  +status: ContentStatus
  +unlockFor(userId: UUID): Boolean
}
}
package "Practice & Assessment" {
  class AssignmentSubmission {
  +id: UUID
  +version: Integer
  +submit(): void
}
  class SkillAssessment {
  +id: UUID
  +evidenceType: String
  +lockEvidence(): void
}
}
package "Project & Teamwork" {
  class Project {
  +id: UUID
  +status: ProjectStatus
  +activate(): void
}
  class Task {
  +id: UUID
  +status: TaskStatus
  +transitionTo(status: TaskStatus): void
}
}
package "AI Learning Support" {
  class AIRequest {
  +id: UUID
  +traceId: UUID
  +complete(): void
}
  class AIInsight {
  +id: UUID
  +confidence: Decimal
  +markNonAuthoritative(): void
}
}
package "Platform" {
  class AuditLog {
  +id: UUID
  +traceId: UUID
  +append(): void
}
  class Notification {
  +id: UUID
  +status: DeliveryStatus
  +markSent(): void
}
}
User "1" -- "1" Profile
User "1" -- "0..*" AssignmentSubmission
LearningPath "1" -- "0..*" Lesson
AssignmentSubmission "1" -- "0..*" SkillAssessment
Project "1" -- "0..*" Task
AIRequest "1" -- "0..*" AIInsight
User "1" -- "0..*" AuditLog
User "1" -- "0..*" Notification
@enduml
