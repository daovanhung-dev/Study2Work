@startuml Study2Work_Assessment_Class
skinparam shadowing false
skinparam dpi 180
skinparam roundcorner 12
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #F8FAFC
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #F97316
}

title Study2Work - Class - Practice & Assessment
class Quiz {
  +id: UUID
  +moduleId: UUID
  +version: Integer
  +status: ContentStatus
  +passScore: Decimal
  +publish(): void
  +freezeSnapshot(): Json
}
class Question {
  +id: UUID
  +quizId: UUID
  +questionType: String
  +orderNo: Integer
  +content: String
}
class Choice {
  +id: UUID
  +questionId: UUID
  +content: String
  +isCorrect: Boolean
}
class QuizAttempt {
  +id: UUID
  +quizId: UUID
  +userId: UUID
  +attemptOrder: Integer
  +status: QuizAttemptStatus
  +score: Decimal
  +submit(): void
  +scoreBySnapshot(): Decimal
  +expire(): void
}
class QuizAnswer {
  +id: UUID
  +attemptId: UUID
  +questionSnapshot: Json
  +answerValue: Json
  +isCorrect: Boolean
}
class Assignment {
  +id: UUID
  +moduleId: UUID
  +title: String
  +dueAt: DateTime
  +allowedAttempts: Integer
  +config: Json
  +isOpen(now: DateTime): Boolean
}
class AssignmentSubmission {
  +id: UUID
  +assignmentId: UUID
  +userId: UUID
  +version: Integer
  +status: SubmissionStatus
  +artifactFileId: UUID
  +submit(): void
  +returnToDraft(reason: String): void
  +markGraded(score: Decimal): void
}
class Rubric {
  +id: UUID
  +assignmentId: UUID
  +version: Integer
  +status: ContentStatus
  +publish(): void
  +validateWeights(): Boolean
}
class RubricCriterion {
  +id: UUID
  +rubricId: UUID
  +criterion: String
  +weight: Decimal
  +required: Boolean
}
class Review {
  +id: UUID
  +submissionId: UUID
  +mentorId: UUID
  +rubricId: UUID
  +status: ReviewStatus
  +totalScore: Decimal
  +finalize(): void
  +requestRevision(reason: String): void
}
class Feedback {
  +id: UUID
  +reviewId: UUID
  +criterionId: UUID
  +comment: String
  +score: Decimal
}
class SkillAssessment {
  +id: UUID
  +userId: UUID
  +skillId: UUID
  +evidenceType: String
  +evidenceId: UUID
  +level: SkillLevel
  +score: Decimal
  +assessedAt: DateTime
  +lockEvidence(): void
}
Quiz "1" *-- "1..*" Question
Question "1" *-- "0..*" Choice
Quiz "1" -- "0..*" QuizAttempt
QuizAttempt "1" *-- "1..*" QuizAnswer
Assignment "1" -- "0..*" AssignmentSubmission
Assignment "1" -- "1..*" Rubric
Rubric "1" *-- "1..*" RubricCriterion
AssignmentSubmission "1" -- "0..*" Review
Review "1" *-- "0..*" Feedback
QuizAttempt "0..*" -- "0..*" SkillAssessment
AssignmentSubmission "0..*" -- "0..*" SkillAssessment
Review "0..*" -- "0..*" SkillAssessment
@enduml
