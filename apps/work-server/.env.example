# Copy this file to .env in the Work server runtime environment.
# The process launcher must load these variables; the application does not
# parse .env files itself.

PORT=3000
APP_ENV=local
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
REDIS_URL=""

JWT_SECRET="replace-with-a-local-secret-of-at-least-32-characters"
JWT_EXPIRES="1d"

# Optional: only required by legacy Supabase modules when they are wired.
SUPABASE_URL="https://example.supabase.co"
SUPABASE_ANON_KEY="replace-with-a-local-supabase-anon-key"
