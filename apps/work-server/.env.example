WORK_APP_ENV=local
WORK_HOST=0.0.0.0
WORK_PORT=8001

# WORK_DATABASE_URL is used by both the Work runtime and Prisma.
WORK_DATABASE_URL=postgresql://study2work:study2work@127.0.0.1:5434/study2work_work
WORK_REDIS_URL=redis://127.0.0.1:6381/0

WORK_CORS_ORIGINS=http://localhost:5174

# Identity publishes ES256 verification keys here. HTTP is accepted only in
# local/test environments; production requires HTTPS.
WORK_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json
WORK_JWT_ISSUER=study2work
WORK_JWT_AUDIENCE=work-api
