{
  "name": "work_server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "s2w": "node --loader ts-node/esm src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "node --loader ts-node/esm scripts/prisma-with-constants.ts generate",
    "prisma:validate": "node --loader ts-node/esm scripts/prisma-with-constants.ts validate",
    "prisma:migrate:deploy": "node --loader ts-node/esm scripts/prisma-with-constants.ts migrate deploy",
    "seed:accounts": "node --loader ts-node/esm scripts/seed-accounts.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@supabase/supabase-js": "^2.84.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.2",
    "@types/node": "22.10.7",
    "prisma": "^6.3.0",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "vitest": "^2.1.9"
  }
}
