// Work persistence is a clean PostgreSQL foundation. Domain models are added
// incrementally from the canonical Basic Design; legacy Learn2Earn MySQL models
// are intentionally not part of this datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("WORK_DATABASE_URL")
}

model SystemRecord {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(120)
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_records")
}
