// This is your Prisma schema file for Neon PostgreSQL,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ====================== SinhVien ======================
model SinhVien {
  id          BigInt  @id @default(autoincrement())
  hoten       String? @db.VarChar(50)
  email       String? @unique @db.VarChar(50)
  matkhau     String? @db.VarChar(20)
  chuyennganh String? @db.VarChar(50)
  avt         String? @db.VarChar(191)

  Chat        Chat[]       @relation("SinhVienChat")
  DoanChat    DoanChat[]
  UngVien     UngVien[]
  Cv          Cv[]
  ThongBaoSVs ThongBaoSV[]
}

// ====================== DoanhNghiep ======================
model DoanhNghiep {
  id          BigInt  @id @default(autoincrement())
  hoten       String? @db.VarChar(50)
  email       String? @unique @db.VarChar(50)
  matkhau     String? @db.VarChar(50)
  diachi      String? @db.VarChar(100)
  sodienthoai String? @db.VarChar(20)
  avt         String? @db.VarChar(191)

  Chat        Chat[]       @relation("DoanhNghiepChat")
  DoanChat    DoanChat[]
  UngVien     UngVien[]
  JD          JD[]
  ThongBaoDNs ThongBaoDN[]
}

// ====================== Chat ======================
model Chat {
  id             BigInt    @id @default(autoincrement())
  sinhvien_id    BigInt?
  doanhnghiep_id BigInt?
  nguoigui       String?   @db.VarChar(191)
  nguoinhan      String?   @db.VarChar(191)
  noidung        String?   @db.VarChar(191)
  ngaygui        DateTime? @db.Timestamptz(3) @default(now())
  trangthai      Boolean?

  SinhVien    SinhVien?    @relation("SinhVienChat", fields: [sinhvien_id], references: [id])
  DoanhNghiep DoanhNghiep? @relation("DoanhNghiepChat", fields: [doanhnghiep_id], references: [id])
}

// ====================== Cv ======================
model Cv {
  id            BigInt    @id @default(autoincrement())
  avt           String?   @db.VarChar(191)
  hoten         String    @db.VarChar(191)
  ngaysinh      DateTime? @db.Timestamptz(3)
  gioitinh      String?   @db.VarChar(191)
  email         String    @db.VarChar(191)
  sdt           String?   @db.VarChar(191)
  diachi        String?   @db.VarChar(191)
  vitri         String?   @db.VarChar(191)
  nganh         String?   @db.VarChar(191)
  muctieunghiep String?   @db.VarChar(191)
  hocvan        String?   @db.VarChar(191)
  kinhnghiem    String?   @db.VarChar(191)
  kynang        String?   @db.VarChar(191)
  ngoaingu      String?   @db.VarChar(191)
  chungchi      String?   @db.VarChar(191)
  duan          String?   @db.VarChar(191)
  giaithuong    String?   @db.VarChar(191)
  hoatdong      String?   @db.VarChar(191)
  social        Json?     @db.JsonB
  portfolio     String?   @db.VarChar(191)
  luongmongmuon String?   @db.VarChar(191)
  created_at    DateTime? @db.Timestamptz(3) @default(now())
  sinhvien_id   BigInt?   @unique
  SinhVien      SinhVien? @relation(fields: [sinhvien_id], references: [id])
}

// ====================== DoanChat ======================
model DoanChat {
  id             BigInt    @id @default(autoincrement())
  sinhvien_id    BigInt
  doanhnghiep_id BigInt
  created_at     DateTime? @db.Timestamptz(3) @default(now())

  SinhVien    SinhVien    @relation(fields: [sinhvien_id], references: [id])
  DoanhNghiep DoanhNghiep @relation(fields: [doanhnghiep_id], references: [id])
}

// ====================== JD ======================
model JD {
  id             BigInt    @id @default(autoincrement())
  ten_vi_tri     String    @db.VarChar(191)
  phong_ban      String?   @db.VarChar(191)
  cap_bac        String?   @db.VarChar(191)
  bao_cao_cho    String?   @db.VarChar(191)
  nhiem_vu       String?   @db.VarChar(191)
  trinh_do       String?   @db.VarChar(191)
  kinh_nghiem    String?   @db.VarChar(191)
  ky_nang        String?   @db.VarChar(191)
  ky_nang_mem    String?   @db.VarChar(191)
  uu_tien        String?   @db.VarChar(191)
  muc_luong      String?   @db.VarChar(191)
  phuc_loi       String?   @db.VarChar(191)
  moi_truong     String?   @db.VarChar(191)
  dia_diem       String?   @db.VarChar(191)
  thoi_gian      String?   @db.VarChar(191)
  han_nop        String?   @db.VarChar(191)
  cach_ung_tuyen String?   @db.VarChar(191)
  ngay_tao       DateTime? @db.Timestamptz(3) @default(now())
  mo_ta          String?   @db.VarChar(191)
  doanhnghiep_id BigInt?
  ten_cong_ty    String?   @db.VarChar(191)
  nganh          String?   @db.VarChar(191)
  avt            String?   @db.VarChar(191)

  DoanhNghiep DoanhNghiep? @relation(fields: [doanhnghiep_id], references: [id])
  TopJD       TopJD[]
  UngViens    UngVien[]
}

// ====================== ThongBaoDN ======================
model ThongBaoDN {
  id_dn          BigInt       @id @default(autoincrement())
  ten_dn         String? @db.VarChar(191)
  email          String? @db.VarChar(191)
  mat_khau       String? @db.VarChar(191)
  sdt            String? @db.VarChar(191)
  logo           String? @db.VarChar(191)
  trang_thai     String? @db.VarChar(191)
  ngay_tao       String? @db.VarChar(191)
  doanhnghiep_id BigInt?
  DoanhNghiep    DoanhNghiep? @relation(fields: [doanhnghiep_id], references: [id])
}

// ====================== ThongBaoSV ======================
model ThongBaoSV {
  id_sv       BigInt    @id @default(autoincrement())
  ho_ten      String? @db.VarChar(191)
  email       String? @db.VarChar(191)
  mat_khau    String? @db.VarChar(191)
  sdt         String? @db.VarChar(191)
  avt_sv      String? @db.VarChar(191)
  trang_thai  String? @db.VarChar(191)
  ngay_tao    String? @db.VarChar(191)
  sinhvien_id BigInt?
  SinhVien    SinhVien? @relation(fields: [sinhvien_id], references: [id])
}

// ====================== TopJD ======================
model TopJD {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @db.Timestamptz(3) @default(now())
  jd_id      BigInt?
  JD         JD?      @relation(fields: [jd_id], references: [id])
}

// ====================== TopCV ======================
model TopCV {
  id BigInt @id @default(autoincrement())
}

// ====================== UngVien ======================
model UngVien {
  id             BigInt   @id @default(autoincrement())
  created_at     DateTime @db.Timestamptz(3) @default(now())
  sinhvien_id    BigInt?
  doanhnghiep_id BigInt?
  trangthai      String?  @db.VarChar(191) @default("chưa ứng tuyển")
  jd_id          BigInt?

  SinhVien    SinhVien?    @relation(fields: [sinhvien_id], references: [id])
  DoanhNghiep DoanhNghiep? @relation(fields: [doanhnghiep_id], references: [id])
  JD          JD?          @relation(fields: [jd_id], references: [id])

  @@unique([jd_id, sinhvien_id], map: "UngVien_jd_sinhvien_key")
}

// ====================== bannganh lookup ======================
model BanNganh {
  nganh String @id @db.VarChar(191)

  @@map("bannganh")
}
