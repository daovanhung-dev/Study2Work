# Full Work public API URL. The API version is part of this value.
VITE_WORK_API_URL=http://localhost:8001/api/v1

# Optional Platform Identity API used to restore the HttpOnly refresh-cookie session.
# Leave unset until the Identity service is available locally.
VITE_IDENTITY_API_URL=

# Hosted login handles sign-in, verification, recovery, and MFA.
VITE_IDENTITY_LOGIN_URL=https://identity.study2work.vn/login
