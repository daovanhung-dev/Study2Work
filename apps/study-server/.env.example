APP_ENV=local
ENABLE_DOCS=true
CORS_ORIGINS=http://127.0.0.2:3002,http://127.0.0.2:3001

DB_HOST=localhost
DB_PORT=5433
DB_NAME=study2work_study
DB_USER=study2work
DB_PASSWORD=study2work
DB_SCHEMA=public
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6380/0

# Cấu hình JWT chuẩn dùng ES256. Lưu giá trị PEM trong trình quản lý bí mật khi triển khai production.
JWT_ALGORITHM=ES256
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-public-key\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=study2work
JWT_AUDIENCE=study-api

# Cần thiết khi bật lớp lưu trữ refresh token dạng opaque.
REFRESH_TOKEN_PEPPER=replace-with-a-long-random-secret

# Phương án dự phòng chỉ dùng cục bộ; chỉ chọn khi không có khóa ES256.
# JWT_ALGORITHM=HS256
# JWT_SECRET_KEY=replace-with-a-long-random-secret
