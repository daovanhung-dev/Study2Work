        <mxCell id="n2" value="&lt;b&gt;GET /api/v1/courses/{course_id}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#475569;&quot;&gt;RBAC: Public&lt;br&gt;In: path{course_id:int64!}&lt;br&gt;Out: ApiEnvelope&amp;lt;Page&lt;Course&gt;&amp;gt;&lt;br&gt;Status: 200 DESIGN_RESOURCE_RETRIEVED&lt;br&gt;Errors: 404 DESIGN_RESOURCE_NOT_FOUND, 500 DESIGN_INTERNAL_ERROR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.6;fontSize=8;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
