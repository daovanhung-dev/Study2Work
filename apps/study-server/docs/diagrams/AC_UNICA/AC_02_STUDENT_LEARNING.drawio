        <mxCell id="title" value="&lt;div style=&quot;font-size:24px;font-weight:700;&quot;&gt;AC-16 — Làm bài kiểm tra&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#64748B;margin-top:4px;&quot;&gt;STUDENT / LEARNING &amp; INTERACTION · 1 UC = 1 AC · API calls: 5&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=center;verticalAlign=middle;" parent="1" vertex="1">
