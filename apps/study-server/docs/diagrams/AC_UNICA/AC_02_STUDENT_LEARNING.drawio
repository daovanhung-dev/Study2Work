        <mxCell id="n1" value="&lt;b&gt;Mở bài kiểm tra&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=16;" parent="1" vertex="1">
          <mxGeometry x="175.0" y="370" width="245" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;GET /api/v1/quizzes/{quiz_id}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#475569;&quot;&gt;RBAC: Student&lt;br&gt;In: path{quiz_id:int64!}&lt;br&gt;Out: ApiEnvelope&amp;lt;Quiz&amp;gt;&lt;br&gt;Status: 200 DESIGN_RESOURCE_RETRIEVED&lt;br&gt;Errors: 401 DESIGN_AUTHENTICATION_REQUIRED, 403 DESIGN_ACCESS_DENIED, 404 DESIGN_RESOURCE_NOT_FOUND, 500 DESIGN_INTERNAL_ERROR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.6;fontSize=8;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="1007.5" y="496" width="320" height="122" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Đọc Quiz + rule + question set&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="1459.5" y="622" width="286" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Được phép làm bài?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#92400E;&quot;&gt;Hết lượt/hết hạn → 403/409.&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1121.5" y="748" width="92" height="92" as="geometry" />
        </mxCell>
        <mxCell id="err4" value="&lt;b&gt;Nhánh NO / ERROR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Hết lượt/hết hạn → 403/409.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.3;fontSize=10;align=center;verticalAlign=middle;spacing=5;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="1885" y="748" width="220" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;POST /api/v1/quizzes/{quiz_id}/attempts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#475569;&quot;&gt;RBAC: Student&lt;br&gt;In: path{quiz_id:int64!}&lt;br&gt;Out: ApiEnvelope&amp;lt;QuizAttempt&amp;gt;&lt;br&gt;Status: 201 DESIGN_RESOURCE_CREATED&lt;br&gt;Errors: 401 DESIGN_AUTHENTICATION_REQUIRED, 403 DESIGN_ACCESS_DENIED, 404 DESIGN_RESOURCE_NOT_FOUND, 422 DESIGN_VALIDATION_ERROR, 409 DESIGN_STATE_CONFLICT, 500 DESIGN_INTERNAL_ERROR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.6;fontSize=8;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="1007.5" y="874" width="320" height="122" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;INSERT Attempt = IN_PROGRESS&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="1459.5" y="1000" width="286" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;Student trả lời câu hỏi&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.3;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="595.0" y="1126" width="275" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;PUT /api/v1/attempts/{attempt_id}/answers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#475569;&quot;&gt;RBAC: Student&lt;br&gt;In: path{attempt_id:int64!}&lt;br&gt;In: body{question_id:int64!, answer(s):string!}&lt;br&gt;Out: ApiEnvelope&amp;lt;QuizAttempt&amp;gt;&lt;br&gt;Status: 200 DESIGN_RESOURCE_UPDATED&lt;br&gt;Errors: 401 DESIGN_AUTHENTICATION_REQUIRED, 403 DESIGN_ACCESS_DENIED, 404 DESIGN_RESOURCE_NOT_FOUND, 422 DESIGN_VALIDATION_ERROR, 500 DESIGN_INTERNAL_ERROR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.6;fontSize=8;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="1007.5" y="1252" width="320" height="122" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;UPSERT AttemptAnswer&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="1459.5" y="1378" width="286" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;Chọn “Nộp bài”&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.4;fontSize=11;align=center;verticalAlign=middle;spacing=5;arcSize=16;" parent="1" vertex="1">
          <mxGeometry x="175.0" y="1504" width="245" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;POST /api/v1/attempts/{attempt_id}/submit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#475569;&quot;&gt;RBAC: Student&lt;br&gt;In: path{attempt_id:int64!}&lt;br&gt;Out: ApiEnvelope&amp;lt;QuizAttempt&amp;gt;&lt;br&gt;Status: 200 DESIGN_RESOURCE_UPDATED&lt;br&gt;Errors: 401 DESIGN_AUTHENTICATION_REQUIRED, 403 DESIGN_ACCESS_DENIED, 404 DESIGN_RESOURCE_NOT_FOUND, 422 DESIGN_VALIDATION_ERROR, 409 DESIGN_STATE_CONFLICT, 500 DESIGN_INTERNAL_ERROR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.6;fontSize=8;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
