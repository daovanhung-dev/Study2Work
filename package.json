{
  "name": "study2work",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "dev:study-web": "corepack pnpm --filter study-web dev",
    "dev:work-web": "corepack pnpm --filter work-web dev",
    "lint": "corepack pnpm -r --if-present lint && corepack pnpm contracts:validate",
    "test": "corepack pnpm -r --if-present test && corepack pnpm contracts:validate",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}
