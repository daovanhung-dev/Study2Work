# Root local-development defaults. App-specific examples live beside each app.

# Study API (`apps/study-server`)
APP_ENV=local
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DB_HOST=localhost
DB_PORT=5433
DB_NAME=study2work_study
DB_USER=study2work
DB_PASSWORD=study2work
DB_SCHEMA=public
REDIS_URL=redis://localhost:6380/0
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=replace-with-a-local-secret-of-at-least-32-characters
JWT_ISSUER=study2work
JWT_AUDIENCE=study-api
REFRESH_TOKEN_PEPPER=replace-with-a-local-secret-of-at-least-32-characters

# Work API (`apps/work-server`)
WORK_APP_ENV=local
WORK_HOST=0.0.0.0
WORK_PORT=8001
WORK_CORS_ORIGINS=http://localhost:5174
WORK_DATABASE_URL=postgresql://study2work:study2work@localhost:5434/study2work_work
WORK_REDIS_URL=redis://localhost:6381/0
WORK_JWT_ISSUER=study2work
WORK_JWT_AUDIENCE=work-api
WORK_JWKS_URL=http://localhost:8080/.well-known/jwks.json

# Work web (`apps/work-client/web`)
VITE_WORK_API_URL=http://localhost:8001/api/v1

# Shared local adapters
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_STUDY=study-private
S3_BUCKET_WORK=work-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STUDY_TO_WORK_WEBHOOK_SECRET=change-me-local
INTERNAL_SERVICE_TOKEN=change-me-local
MAIL_PROVIDER=mailhog
MAIL_FROM=no-reply@study2work.local
